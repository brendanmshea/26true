---
import '../styles/global.css';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { raceData } from '../data/raceData';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { general } = raceData;
const {
  title = `${general.name} — ${general.tagline}`,
  description = general.description,
  image = '/images/race_locations_logo.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://26true.com');
---

<!doctype html>
<html lang="en" class="bg-black text-neutral-100 antialiased selection:bg-[#d4ff00] selection:text-black">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts: Plus Jakarta Sans for body -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      :root {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      h1, h2, h3, h4, .font-edo {
        font-family: 'Edo', cursive, system-ui, sans-serif;
        letter-spacing: 0.04em;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-black text-neutral-100">
    <AnnouncementBanner />
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
