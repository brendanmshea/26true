---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { general } = raceData;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/course', label: 'Course' },
  { href: '/race', label: 'Race' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/history', label: 'History' },
  { href: '/faq', label: 'FAQ' },
];
---

<header
  id="main-header"
  data-is-home={isHome ? "true" : "false"}
  class={`z-50 w-full bg-black/90 backdrop-blur-md border-b border-neutral-900 shadow-xl shadow-black/50 transition-transform duration-300 ease-in-out md:sticky md:top-0 md:translate-y-0 ${
    isHome
      ? 'fixed top-0 inset-x-0 -translate-y-full'
      : 'sticky top-0 translate-y-0'
  }`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logos -->
      <a href="/" class="flex items-center gap-3.5 group">
        <img
          src="/images/race_logo.png"
          alt="26.TRUE Marathon Logo"
          class="h-12 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div class="hidden sm:flex flex-col border-l border-neutral-800 pl-3">
          <span class="font-edo text-xl text-white tracking-wider flex items-center gap-1.5">
            26.TRUE <span class="w-2 h-2 rounded-full bg-[#d4ff00] inline-block"></span>
          </span>
          <span class="text-[10px] font-bold tracking-widest text-[#3fd4a4] uppercase">
            Presented by PIONEERS
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 text-sm font-bold uppercase tracking-wider rounded-lg transition-all ${
                isActive
                  ? 'text-[#d4ff00] bg-neutral-900 border-b-2 border-[#d4ff00]'
                  : 'text-neutral-300 hover:text-white hover:bg-neutral-900/80'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={general.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] rounded-xl shadow-lg shadow-[#d4ff00]/20 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Register</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden p-2.5 rounded-xl text-neutral-400 hover:text-white hover:bg-neutral-900 focus:outline-hidden"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-900 bg-black/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2 max-h-[calc(100vh-5rem)] overflow-y-auto">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2.5 rounded-lg text-sm font-bold uppercase tracking-wider text-neutral-300 hover:text-[#d4ff00] hover:bg-neutral-900"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-4">
      <a
        href={general.registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 px-5 py-3 text-xs font-black uppercase tracking-wider text-black bg-[#d4ff00] rounded-xl"
      >
        <span>Register on Movemint</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileNavbar() {
    const header = document.getElementById('main-header');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!header) return;

    // Threshold in pixels before sliding in the navbar on mobile
    const SCROLL_THRESHOLD = 50;

    function isMenuOpen() {
      return menu ? !menu.classList.contains('hidden') : false;
    }

    function updateNavbar() {
      const isMobile = window.innerWidth < 768; // < md breakpoint
      if (!isMobile) {
        // Always visible and sticky on desktop
        header.classList.remove('-translate-y-full');
        header.classList.add('translate-y-0');
        return;
      }

      // Check if current page is the homepage
      const rawPath = (window.location.pathname || '').replace(/\/+$/, '') || '/';
      const isHomePage = rawPath === '/' || header.getAttribute('data-is-home') === 'true';

      if (!isHomePage) {
        // On all other pages: always show the navbar on mobile
        header.classList.remove('-translate-y-full');
        header.classList.add('translate-y-0');
        return;
      }

      // On mobile homepage: hidden only when scrolled to top and drawer menu is closed
      if (isMenuOpen() || window.scrollY > SCROLL_THRESHOLD) {
        header.classList.remove('-translate-y-full');
        header.classList.add('translate-y-0');
      } else {
        header.classList.remove('translate-y-0');
        header.classList.add('-translate-y-full');
      }
    }

    // Toggle mobile menu drawer
    if (btn && menu && menuIcon && closeIcon) {
      btn.onclick = (e) => {
        e.stopPropagation();
        const willBeHidden = !menu.classList.contains('hidden');
        if (willBeHidden) {
          menu.classList.add('hidden');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        } else {
          menu.classList.remove('hidden');
          menuIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        }
        updateNavbar();
      };

      // Auto-close menu if a navigation link inside drawer is clicked
      const drawerLinks = menu.querySelectorAll('a');
      drawerLinks.forEach((link) => {
        link.onclick = () => {
          menu.classList.add('hidden');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          updateNavbar();
        };
      });
    }

    // Scroll listener throttled via requestAnimationFrame for 60fps smoothness
    if (!header.dataset.navInitialized) {
      header.dataset.navInitialized = 'true';
      let ticking = false;

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateNavbar();
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true }
      );

      window.addEventListener('resize', updateNavbar, { passive: true });
    }

    // Run immediately on page load / route navigation
    updateNavbar();
  }

  // Support direct page load & Astro client router transitions
  setupMobileNavbar();
  document.addEventListener('astro:page-load', setupMobileNavbar);
</script>
