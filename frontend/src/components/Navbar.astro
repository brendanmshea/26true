---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { general } = raceData;

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/course', label: 'Course' },
  { href: '/race', label: 'Race' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/history', label: 'History' },
  { href: '/faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 w-full bg-black/90 backdrop-blur-md border-b border-neutral-900 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logos -->
      <a href="/" class="flex items-center gap-3.5 group">
        <img
          src="/images/race_logo.png"
          alt="26.TRUE Marathon Logo"
          class="h-12 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div class="hidden sm:flex flex-col border-l border-neutral-800 pl-3">
          <span class="font-edo text-xl text-white tracking-wider flex items-center gap-1.5">
            26.TRUE <span class="w-2 h-2 rounded-full bg-[#d4ff00] inline-block"></span>
          </span>
          <span class="text-[10px] font-bold tracking-widest text-[#3fd4a4] uppercase">
            Presented by PIONEERS
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 text-sm font-bold uppercase tracking-wider rounded-lg transition-all ${
                isActive
                  ? 'text-[#d4ff00] bg-neutral-900 border-b-2 border-[#d4ff00]'
                  : 'text-neutral-300 hover:text-white hover:bg-neutral-900/80'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={general.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] rounded-xl shadow-lg shadow-[#d4ff00]/20 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Register</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden p-2.5 rounded-xl text-neutral-400 hover:text-white hover:bg-neutral-900 focus:outline-hidden"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-900 bg-black px-4 pt-3 pb-6 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2.5 rounded-lg text-sm font-bold uppercase tracking-wider text-neutral-300 hover:text-[#d4ff00] hover:bg-neutral-900"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-4">
      <a
        href={general.registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 px-5 py-3 text-xs font-black uppercase tracking-wider text-black bg-[#d4ff00] rounded-xl"
      >
        <span>Register on Movemint</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden', !isExpanded);
      closeIcon.classList.toggle('hidden', isExpanded);
    });
  }
</script>
