---
import { raceData } from '../data/raceData';
const { sponsors, general } = raceData;

const titleSponsors = sponsors.filter((s) => s.tier === 'title');
const goldSponsors = sponsors.filter((s) => s.tier === 'gold');
const communitySponsors = sponsors.filter((s) => s.tier === 'community');
---

<section class="py-20 lg:py-28 bg-slate-900/30 border-y border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3">
        Our Partners
      </h2>
      <p class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        Powered by Community Champions
      </p>
      <p class="text-sm text-slate-400 mt-3">
        Proudly supported by leading endurance brands, regional health networks, and local businesses.
      </p>
    </div>

    <!-- Title Sponsors -->
    <div class="mb-14">
      <div class="text-center text-xs font-bold uppercase tracking-wider text-slate-400 mb-6">
        Title & Presenting Partners
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {titleSponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-slate-950/80 border border-slate-800 hover:border-emerald-500/50 rounded-2xl p-8 flex flex-col items-center justify-center text-center transition-all hover:-translate-y-0.5 group"
          >
            <div class="text-2xl font-black text-white tracking-wider group-hover:text-emerald-400 transition-colors mb-2">
              {sponsor.logoText}
            </div>
            {sponsor.tagline && (
              <div class="text-xs text-slate-400">
                {sponsor.tagline}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Gold Sponsors -->
    <div class="mb-14">
      <div class="text-center text-xs font-bold uppercase tracking-wider text-slate-400 mb-6">
        Official Fuel & Community Sponsors
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {goldSponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-slate-950/60 border border-slate-800 hover:border-slate-700 rounded-xl p-6 flex flex-col items-center justify-center text-center transition-colors group"
          >
            <div class="text-lg font-black text-slate-200 tracking-wide group-hover:text-white transition-colors mb-1">
              {sponsor.logoText}
            </div>
            {sponsor.tagline && (
              <div class="text-[11px] text-slate-400">
                {sponsor.tagline}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Community Partners -->
    <div>
      <div class="text-center text-xs font-bold uppercase tracking-wider text-slate-400 mb-6">
        Local Community Partners
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4 max-w-4xl mx-auto">
        {communitySponsors.map((sponsor) => (
          <div class="bg-slate-950/40 border border-slate-800/80 px-5 py-3 rounded-xl text-xs font-semibold text-slate-400">
            {sponsor.logoText}
          </div>
        ))}
      </div>
    </div>

    <!-- Sponsor CTA Box -->
    <div class="mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 bg-slate-950 border border-slate-800 rounded-2xl p-6">
        <div class="text-left">
          <div class="text-sm font-bold text-white">Interested in partnering with 26True?</div>
          <div class="text-xs text-slate-400">Reach 3,500 dedicated runners and thousands of enthusiastic spectators.</div>
        </div>
        <a
          href={`mailto:${general.sponsorEmail}?subject=26True%20Sponsorship%20Inquiry`}
          class="shrink-0 px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors"
        >
          Request Sponsor Deck
        </a>
      </div>
    </div>

  </div>
</section>
