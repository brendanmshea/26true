---
import { raceData } from '../data/raceData';
const { announcement } = raceData;
---

{announcement && announcement.active && (
  <div class="bg-black border-b border-neutral-800 text-neutral-200 text-xs sm:text-sm font-medium py-2.5 px-4 relative z-50">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 flex-wrap">
        <span class="bg-[#d4ff00] text-black uppercase font-black text-[10px] tracking-wider px-2 py-0.5 rounded-full">
          {announcement.badge}
        </span>
        <span class="text-neutral-300">{announcement.message}</span>
      </div>
      {announcement.linkText && (
        <a 
          href={announcement.linkUrl} 
          class="shrink-0 font-bold text-[#d4ff00] hover:text-[#3fd4a4] transition-colors flex items-center gap-1 underline underline-offset-2"
        >
          {announcement.linkText} &rarr;
        </a>
      )}
    </div>
  </div>
)}
