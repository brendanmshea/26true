---
import { raceData } from '../data/raceData';
const { scheduleDays } = raceData;
---

<section class="py-20 lg:py-28 bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3">
        Race Weekend Schedule
      </h2>
      <p class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        Plan Your Weekend From Expo To Finish Line
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {scheduleDays.map((day) => (
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-800">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">
                  {day.dayOfWeek}
                </span>
                <h3 class="text-lg font-bold text-white">
                  {day.date}
                </h3>
              </div>
              <span class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-300 font-mono text-xs font-bold">
                {day.events.length}
              </span>
            </div>

            <div class="space-y-6">
              {day.events.map((evt) => (
                <div class="relative pl-6 border-l-2 border-emerald-500/30 hover:border-emerald-400 transition-colors">
                  <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-emerald-400"></div>
                  <div class="text-xs font-mono font-bold text-emerald-400 mb-1">
                    {evt.time}
                  </div>
                  <h4 class="text-base font-bold text-white mb-1">
                    {evt.title}
                  </h4>
                  <div class="text-xs font-medium text-slate-400 mb-2 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>{evt.location}</span>
                  </div>
                  <p class="text-xs text-slate-400 leading-relaxed">
                    {evt.description}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-800/60 text-right">
            <a href="/schedule" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 transition-colors">
              Full Schedule Details &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
