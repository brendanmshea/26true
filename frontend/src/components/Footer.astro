---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { general } = raceData;

const currentYear = new Date().getFullYear();
const regOpenTime = new Date(general.registrationOpenDate || '2026-11-20T08:00:00-05:00').getTime();
const isPreRegistration = Date.now() < regOpenTime;
---

<footer class="bg-black border-t border-neutral-900 text-neutral-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      
      <!-- Brand & Mission (2 cols on desktop/tablet) -->
      <div class="md:col-span-2 lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <img
            src="/images/race_logo.png"
            alt="26.TRUE Logo"
            class="h-10 w-auto object-contain"
          />
          <div class="flex flex-col">
            <span class="font-edo text-2xl text-white tracking-wider">
              26.TRUE
            </span>
            <span class="text-[10px] font-bold text-[#3fd4a4] uppercase tracking-widest">
              Our City. Our Way.
            </span>
          </div>
        </a>
        <p class="text-xs sm:text-sm text-neutral-400 max-w-sm leading-relaxed font-normal">
          {general.description}
        </p>
        <div class="pt-2 flex items-center gap-3">
          <img
            src="/images/Pioneers Logo - white.svg"
            alt="PIONEERS Run Crew"
            class="h-7 w-auto object-contain opacity-75"
          />
          <span class="text-xs text-neutral-400">
            Founded & Organized by <strong class="text-white">PIONEERS Run Crew</strong>
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-[#d4ff00] mb-4">
          Explore
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm font-semibold">
          <li><a href="/course" class="hover:text-[#d4ff00] transition-colors">Neighborhood Course</a></li>
          <li><a href="/race" class="hover:text-[#d4ff00] transition-colors">Race Info</a></li>
          <li><a href="/gallery" class="hover:text-[#d4ff00] transition-colors">Photo Gallery</a></li>
          <li><a href="/history" class="hover:text-[#d4ff00] transition-colors">Origin & History</a></li>
          <li><a href="/faq" class="hover:text-[#d4ff00] transition-colors">FAQ & Guide</a></li>
        </ul>
      </div>

      <!-- Contact & Community -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-white mb-4">
          Get Involved
        </h4>
        <div class="space-y-2 text-xs sm:text-sm">
          <p>Contact us at:</p>
          <p><a href={`mailto:${general.contactEmail}`} class="hover:text-[#d4ff00] transition-colors">{general.contactEmail}</a></p>
        </div>
        <div class="mt-6" data-reg-open-date={general.registrationOpenDate || '2026-11-20T08:00:00-05:00'}>
          <!-- Pre-registration notice in footer (not a button) -->
          <div
            id="footer-reg-prereg"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-neutral-300 bg-neutral-900 border border-neutral-800 select-none cursor-default"
            style={isPreRegistration ? '' : 'display: none;'}
            aria-label="Registration status"
          >
            <span class="w-2 h-2 rounded-full bg-[#d4ff00] animate-pulse"></span>
            <span>Registration opens Nov 20</span>
          </div>

          <!-- Active Register button in footer -->
          <a
            id="footer-reg-btn"
            href={general.registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-[#d4ff00] text-black hover:bg-[#c3ec00] transition-colors"
            style={isPreRegistration ? 'display: none;' : ''}
          >
            <span>Register on Movemint</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-neutral-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400">
      <div>
        &copy; {currentYear} {general.name} &bull; PIONEERS Run Crew. Hosted on Cloudflare Pages.
      </div>
      <div class="flex items-center gap-6">
        <a href="/faq" class="hover:text-white transition-colors">Runner Guide</a>
        <a href="https://www.pioneersrc.com" target="_blank" rel="noopener noreferrer" class="text-[#3fd4a4] hover:text-[#d4ff00] transition-colors font-bold">PIONEERS Run Crew</a>
      </div>
    </div>
  </div>
</footer>

<script>
  function updateFooterRegistration() {
    const prereg = document.getElementById('footer-reg-prereg');
    const btn = document.getElementById('footer-reg-btn');
    if (!prereg && !btn) return;

    const parent = prereg?.parentElement || btn?.parentElement;
    const regDateStr = parent?.getAttribute('data-reg-open-date') || '2026-11-20T08:00:00-05:00';
    const regOpenTime = new Date(regDateStr).getTime();
    const isOpen = Date.now() >= regOpenTime;

    if (isOpen) {
      if (prereg) prereg.style.display = 'none';
      if (btn) btn.style.display = '';
    } else {
      if (prereg) prereg.style.display = '';
      if (btn) btn.style.display = 'none';
    }
  }

  updateFooterRegistration();

  if (!(window as any).__footerRegIntervalSet) {
    (window as any).__footerRegIntervalSet = true;
    setInterval(updateFooterRegistration, 1000);
  }

  document.addEventListener('astro:page-load', updateFooterRegistration);
</script>
