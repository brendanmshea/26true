---
import { raceData } from '../data/raceData';
const { general } = raceData;
---

<section class="relative overflow-hidden bg-slate-950 pt-16 pb-24 lg:pt-24 lg:pb-32">
  <!-- Dynamic Background Glow & Grid -->
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-tr from-emerald-500/40 via-teal-500/30 to-blue-600/30 blur-[130px] rounded-full"></div>
    <div class="absolute bottom-0 right-10 w-[400px] h-[400px] bg-emerald-500/20 blur-[100px] rounded-full"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Badges -->
      <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 backdrop-blur-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          USATF Certified BQ
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold text-slate-300 bg-slate-900 border border-slate-800">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {general.displayDate}
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold text-slate-300 bg-slate-900 border border-slate-800">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {general.cityState}
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight uppercase leading-[1.05] mb-6">
        The Purest 26.2.<br />
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-sky-400 bg-clip-text text-transparent">
          Just Grit & Community.
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        An authentic, runner-first marathon and half marathon engineered for PRs. Fast net-downhill course, world-class Maurten fuel stations, and an electric crowd cheering you to the line.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a
          href={general.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-extrabold text-slate-950 bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 rounded-2xl shadow-xl shadow-emerald-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Claim Your Bib on RunSignup</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <a
          href="/course"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-bold text-white bg-slate-900/90 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 rounded-2xl transition-all"
        >
          <span>Explore Course & Elevation</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Live Countdown Card -->
      <div class="max-w-xl mx-auto bg-slate-900/60 border border-slate-800/80 rounded-3xl p-6 backdrop-blur-md shadow-2xl">
        <div class="text-xs uppercase tracking-widest text-slate-400 font-bold mb-4 flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          Countdown to Race Morning
        </div>
        
        <div class="grid grid-cols-4 gap-2 sm:gap-4 text-center" id="countdown-timer" data-target-date={general.date}>
          <div class="bg-slate-950/80 border border-slate-800/80 rounded-2xl p-3 sm:p-4">
            <div class="text-2xl sm:text-4xl font-black text-white" id="count-days">--</div>
            <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-slate-400 mt-1">Days</div>
          </div>
          <div class="bg-slate-950/80 border border-slate-800/80 rounded-2xl p-3 sm:p-4">
            <div class="text-2xl sm:text-4xl font-black text-white" id="count-hours">--</div>
            <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-slate-400 mt-1">Hours</div>
          </div>
          <div class="bg-slate-950/80 border border-slate-800/80 rounded-2xl p-3 sm:p-4">
            <div class="text-2xl sm:text-4xl font-black text-white" id="count-mins">--</div>
            <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-slate-400 mt-1">Mins</div>
          </div>
          <div class="bg-slate-950/80 border border-slate-800/80 rounded-2xl p-3 sm:p-4">
            <div class="text-2xl sm:text-4xl font-black text-emerald-400" id="count-secs">--</div>
            <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-slate-400 mt-1">Secs</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function updateCountdown() {
    const timerEl = document.getElementById('countdown-timer');
    if (!timerEl) return;
    
    const targetDateStr = timerEl.getAttribute('data-target-date');
    if (!targetDateStr) return;

    const target = new Date(targetDateStr).getTime();
    const now = new Date().getTime();
    const diff = target - now;

    const daysEl = document.getElementById('count-days');
    const hoursEl = document.getElementById('count-hours');
    const minsEl = document.getElementById('count-mins');
    const secsEl = document.getElementById('count-secs');

    if (diff <= 0) {
      if (daysEl) daysEl.innerText = '00';
      if (hoursEl) hoursEl.innerText = '00';
      if (minsEl) minsEl.innerText = '00';
      if (secsEl) secsEl.innerText = '00';
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    if (daysEl) daysEl.innerText = String(days).padStart(2, '0');
    if (hoursEl) hoursEl.innerText = String(hours).padStart(2, '0');
    if (minsEl) minsEl.innerText = String(minutes).padStart(2, '0');
    if (secsEl) secsEl.innerText = String(seconds).padStart(2, '0');
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
