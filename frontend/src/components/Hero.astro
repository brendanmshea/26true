---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { general } = raceData;
---

<section class="relative overflow-hidden bg-black pt-6 sm:pt-8 lg:pt-10 pb-6 sm:pb-8 lg:pb-12">
  <!-- Subtle Ambient Glow -->
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute -top-12 right-1/4 w-[450px] h-[450px] bg-[#d4ff00]/10 blur-[150px] rounded-full"></div>
    <div class="absolute bottom-0 left-10 w-[350px] h-[350px] bg-[#3fd4a4]/10 blur-[130px] rounded-full"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Copy -->
      <div class="lg:col-span-7 text-left">
        
        <!-- Race Date Badge -->
        <div class="flex items-center gap-2.5 mb-3 sm:mb-4">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold text-neutral-200 bg-neutral-900/90 border border-neutral-800 backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-[#3fd4a4] animate-pulse"></span>
            {general.raceDisplayDate}
          </span>
        </div>

        <!-- Main Headline using Edo Font -->
        <h1 class="font-edo text-5xl sm:text-7xl lg:text-8xl text-white tracking-normal uppercase leading-[0.95] mb-4 sm:mb-5">
          OUR CITY.<br />
          <span class="text-[#d4ff00] drop-shadow-[0_2px_20px_rgba(212,255,0,0.35)]">
            OUR WAY.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-neutral-200 max-w-xl leading-relaxed font-normal">
          An untimed, community-first marathon and half marathon created by <span class="text-[#3fd4a4] font-bold">PIONEERS Run Crew</span>. Running 100% inside Boston city limits.
        </p>

      </div>

      <!-- Right Column: CTAs, Countdown Widget & Race Logo -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center gap-5">
        
        <!-- Action Buttons -->
        <div class="w-full max-w-md flex flex-col sm:flex-row gap-3">
          <a
            href={general.registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-xs sm:text-sm font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] rounded-2xl shadow-xl shadow-[#d4ff00]/20 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            <span id="hero-btn-text">Register on Movemint</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href="/course"
            class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-white bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 hover:border-neutral-700 rounded-2xl backdrop-blur-md transition-all text-center"
          >
            <span>Explore Course</span>
          </a>
        </div>

        <!-- Dynamic Two-Stage Countdown Widget -->
        <div class="w-full max-w-md bg-neutral-950/85 border border-neutral-800 rounded-3xl p-5 sm:p-6 backdrop-blur-md shadow-2xl">
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="text-[11px] uppercase tracking-widest text-neutral-300 font-black flex items-center gap-2" id="countdown-label">
              <span class="w-2 h-2 rounded-full bg-[#d4ff00] animate-ping"></span>
              Registration Opens in:
            </div>
          </div>
          
          <div
            class="grid grid-cols-4 gap-2 sm:gap-3 text-center"
            id="countdown-timer"
            data-reg-date={general.registrationOpenDate}
            data-race-date={general.raceDate}
          >
            <div class="bg-neutral-900/90 border border-neutral-800 rounded-xl p-2.5 sm:p-3">
              <div class="font-edo text-2xl sm:text-3xl text-white" id="count-days">--</div>
              <div class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-neutral-400 mt-0.5">Days</div>
            </div>
            <div class="bg-neutral-900/90 border border-neutral-800 rounded-xl p-2.5 sm:p-3">
              <div class="font-edo text-2xl sm:text-3xl text-white" id="count-hours">--</div>
              <div class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-neutral-400 mt-0.5">Hours</div>
            </div>
            <div class="bg-neutral-900/90 border border-neutral-800 rounded-xl p-2.5 sm:p-3">
              <div class="font-edo text-2xl sm:text-3xl text-white" id="count-mins">--</div>
              <div class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-neutral-400 mt-0.5">Mins</div>
            </div>
            <div class="bg-neutral-900/90 border border-neutral-800 rounded-xl p-2.5 sm:p-3">
              <div class="font-edo text-2xl sm:text-3xl text-[#d4ff00]" id="count-secs">--</div>
              <div class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-neutral-400 mt-0.5">Secs</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function updateCountdown() {
    const timerEl = document.getElementById('countdown-timer');
    if (!timerEl) return;
    
    const regDateStr = timerEl.getAttribute('data-reg-date');
    const raceDateStr = timerEl.getAttribute('data-race-date');
    if (!regDateStr || !raceDateStr) return;

    const regTarget = new Date(regDateStr).getTime();
    const raceTarget = new Date(raceDateStr).getTime();
    const now = new Date().getTime();

    const labelEl = document.getElementById('countdown-label');
    const sublabelEl = document.getElementById('countdown-sublabel');
    const btnTextEl = document.getElementById('hero-btn-text');

    let target = regTarget;
    let isPreReg = true;

    if (now < regTarget) {
      // Stage 1: Countdown to Registration
      target = regTarget;
      isPreReg = true;
      if (labelEl) {
        labelEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-[#d4ff00] animate-ping"></span> Registration Opens In:';
      }
      if (sublabelEl) {
        sublabelEl.innerText = 'Opens Nov 20 @ 8 AM EST';
      }
      if (btnTextEl) {
        btnTextEl.innerText = 'Registration Opens Nov 20';
      }
    } else {
      // Stage 2: Countdown to Race Morning
      target = raceTarget;
      isPreReg = false;
      if (labelEl) {
        labelEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-[#3fd4a4] animate-ping"></span> Countdown to Race Day';
      }
      if (sublabelEl) {
        sublabelEl.innerText = 'Saturday, April 17, 2027';
      }
      if (btnTextEl) {
        btnTextEl.innerText = 'Register on Movemint';
      }
    }

    const diff = target - now;

    const daysEl = document.getElementById('count-days');
    const hoursEl = document.getElementById('count-hours');
    const minsEl = document.getElementById('count-mins');
    const secsEl = document.getElementById('count-secs');

    if (diff <= 0) {
      if (daysEl) daysEl.innerText = '00';
      if (hoursEl) hoursEl.innerText = '00';
      if (minsEl) minsEl.innerText = '00';
      if (secsEl) secsEl.innerText = '00';
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    if (daysEl) daysEl.innerText = String(days).padStart(2, '0');
    if (hoursEl) hoursEl.innerText = String(hours).padStart(2, '0');
    if (minsEl) minsEl.innerText = String(minutes).padStart(2, '0');
    if (secsEl) secsEl.innerText = String(seconds).padStart(2, '0');
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
