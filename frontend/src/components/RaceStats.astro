---
import { raceData } from '../data/raceData';
const { stats } = raceData;
---

<section class="bg-slate-900/40 border-y border-slate-800/80 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {stats.map((stat, idx) => (
        <div class="relative bg-slate-950/60 border border-slate-800/80 rounded-2xl p-6 hover:border-emerald-500/40 transition-colors group">
          <div class="text-[11px] font-bold uppercase tracking-widest text-emerald-400 mb-2">
            {stat.label}
          </div>
          <div class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-2 group-hover:text-emerald-300 transition-colors">
            {stat.value}
          </div>
          <div class="text-xs sm:text-sm text-slate-400 leading-snug">
            {stat.subtext}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
