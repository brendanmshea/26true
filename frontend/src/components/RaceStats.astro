---
import { raceData } from '../data/raceData';
const { stats } = raceData;
---

<section class="bg-black border-y border-neutral-900 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {stats.map((stat, idx) => (
        <div class="relative bg-neutral-950/80 border border-neutral-800/80 rounded-2xl p-6 hover:border-[#d4ff00]/40 transition-all group">
          <div class="text-[10px] font-black uppercase tracking-widest text-[#3fd4a4] mb-2">
            {stat.label}
          </div>
          <div class="font-edo text-3xl sm:text-4xl text-white tracking-wider mb-2 group-hover:text-[#d4ff00] transition-colors">
            {stat.value}
          </div>
          <div class="text-xs text-neutral-400 leading-snug">
            {stat.subtext}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
