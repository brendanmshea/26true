---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { gallery = [] } = raceData;

// Curate photos for the homepage showcase:
// 1. Prioritize photos explicitly marked with "featuredOnHome: true" in Sanity CMS (ordered by display order)
// 2. Gracefully backfill with top gallery photos if fewer than 6 are toggled on
const featuredPhotos = (gallery || [])
  .filter((p: any) => p.featuredOnHome === true)
  .sort((a: any, b: any) => (a.order ?? 10) - (b.order ?? 10));

const unfeaturedPhotos = (gallery || [])
  .filter((p: any) => !p.featuredOnHome)
  .sort((a: any, b: any) => (a.order ?? 10) - (b.order ?? 10));

const showcasePhotos = (
  featuredPhotos.length >= 6
    ? featuredPhotos.slice(0, 6)
    : [...featuredPhotos, ...unfeaturedPhotos].slice(0, 6)
);
---

<section aria-label="26.TRUE Photo Showcase" class="py-10 sm:py-14 lg:py-16 bg-black border-t border-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial Asymmetrical Photo Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-5" id="home-photo-grid">
      {showcasePhotos.map((photo: any, index: number) => {
        // Layout: 1st photo spans 7 cols (featured), 2nd spans 5 cols (portrait), next 3 span 4 cols each (triplet)
        let colSpan = 'lg:col-span-4 aspect-[4/3]';
        if (index === 0) colSpan = 'lg:col-span-7 aspect-[16/10] sm:aspect-[16/10]';
        if (index === 1) colSpan = 'lg:col-span-5 aspect-[16/10] sm:aspect-[16/10]';
        if (index === 2) colSpan = 'lg:col-span-4 aspect-[4/3]';
        if (index === 3) colSpan = 'lg:col-span-4 aspect-[4/3]';
        if (index === 4) colSpan = 'lg:col-span-4 aspect-[4/3]';
        if (index === 5) colSpan = 'lg:col-span-12 aspect-[21/9] sm:aspect-[21/9] hidden lg:block';

        return (
          <button
            type="button"
            class={`home-photo-item group relative block overflow-hidden rounded-3xl bg-neutral-950 border border-neutral-800 ${colSpan} w-full text-left cursor-pointer hover:border-[#d4ff00]/60 transition-all duration-300 hover:-translate-y-1 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]`}
            data-src={photo.src}
            data-alt={photo.alt}
            data-photographer={photo.photographer || ''}
            data-index={index}
            aria-label={`View photo ${index + 1} in large view`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Hover Expand Badge -->
            <div class="absolute inset-0 p-5 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
              <div class="flex items-center justify-end">
                <span class="w-9 h-9 rounded-full bg-black/80 backdrop-blur-md border border-neutral-700 text-[#d4ff00] flex items-center justify-center shadow-lg">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                </span>
              </div>
              
              {photo.photographer && (
                <div>
                  <span class="px-3 py-1 rounded-full text-[11px] font-semibold text-neutral-200 bg-black/85 backdrop-blur-md border border-neutral-800 shadow">
                    📷 {photo.photographer}
                  </span>
                </div>
              )}
            </div>
          </button>
        );
      })}
    </div>

    <!-- Explore Gallery CTA Button Below Photostrip -->
    <div class="mt-8 sm:mt-10 flex justify-center">
      <a
        href="/gallery"
        class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-2xl text-xs sm:text-sm font-black uppercase tracking-wider bg-neutral-900 hover:bg-neutral-800 text-[#d4ff00] hover:text-[#3fd4a4] border border-neutral-800 hover:border-neutral-700 shadow-xl transition-all transform hover:-translate-y-0.5"
      >
        <span>Explore Full Gallery ({gallery?.length || 7} Photos)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Lightbox Modal for Homepage -->
    <div
      id="home-photo-lightbox"
      class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300 select-none items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-label="Photo Lightbox"
    >
      <div id="home-lightbox-backdrop" class="absolute inset-0 bg-black/95 backdrop-blur-xl"></div>

      <!-- Top bar -->
      <div class="absolute top-0 inset-x-0 z-30 p-4 sm:p-6 flex items-center justify-between pointer-events-none">
        <div class="pointer-events-auto flex items-center gap-2.5 px-4 py-2 rounded-full bg-neutral-900/90 border border-neutral-800 text-xs font-bold text-neutral-300 shadow-xl">
          <span class="text-[#d4ff00] uppercase tracking-wider font-black">26.TRUE</span>
          <span id="home-lightbox-counter" class="text-white">1 / 1</span>
        </div>

        <button
          id="home-lightbox-close"
          type="button"
          class="pointer-events-auto w-11 h-11 rounded-full bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 hover:text-white flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
          aria-label="Close photo view (Esc)"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Previous Button -->
      <button
        id="home-lightbox-prev"
        type="button"
        class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-black/85 hover:bg-neutral-900 border border-neutral-700/80 text-white hover:text-[#d4ff00] flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
        aria-label="Previous photo (Left arrow)"
      >
        <svg class="w-6 h-6 sm:w-7 sm:h-7 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Next Button -->
      <button
        id="home-lightbox-next"
        type="button"
        class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-black/85 hover:bg-neutral-900 border border-neutral-700/80 text-white hover:text-[#d4ff00] flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
        aria-label="Next photo (Right arrow)"
      >
        <svg class="w-6 h-6 sm:w-7 sm:h-7 -mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7m0 0l-7 7"/>
        </svg>
      </button>

      <!-- Main Image Presentation Stage -->
      <div class="relative z-20 w-full h-full flex flex-col items-center justify-center p-4 sm:p-12 pointer-events-none">
        <div class="relative pointer-events-auto max-h-[82vh] max-w-[90vw] flex flex-col items-center">
          <img
            id="home-lightbox-img"
            src=""
            alt=""
            class="max-h-[76vh] sm:max-h-[80vh] max-w-[92vw] sm:max-w-[85vw] object-contain rounded-2xl shadow-2xl border border-neutral-800/80 transition-transform duration-200"
          />
          <div id="home-lightbox-photographer" class="mt-3 text-center text-xs font-semibold text-neutral-400"></div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const homeItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.home-photo-item'));
  const homeLightbox = document.getElementById('home-photo-lightbox');
  const homeLightboxBackdrop = document.getElementById('home-lightbox-backdrop');
  const homeLightboxImg = document.getElementById('home-lightbox-img') as HTMLImageElement | null;
  const homeLightboxCounter = document.getElementById('home-lightbox-counter');
  const homeLightboxPhotographer = document.getElementById('home-lightbox-photographer');
  const homeLightboxClose = document.getElementById('home-lightbox-close');
  const homeLightboxPrev = document.getElementById('home-lightbox-prev');
  const homeLightboxNext = document.getElementById('home-lightbox-next');

  let homeCurrentIndex = 0;

  function updateHomeLightbox(index: number) {
    if (!homeItems.length || !homeLightboxImg) return;

    if (index < 0) {
      homeCurrentIndex = homeItems.length - 1;
    } else if (index >= homeItems.length) {
      homeCurrentIndex = 0;
    } else {
      homeCurrentIndex = index;
    }

    const item = homeItems[homeCurrentIndex];
    const src = item.getAttribute('data-src') || '';
    const alt = item.getAttribute('data-alt') || '26.TRUE Photo';
    const photographer = item.getAttribute('data-photographer') || '';

    homeLightboxImg.src = src;
    homeLightboxImg.alt = alt;

    if (homeLightboxCounter) {
      homeLightboxCounter.textContent = `${homeCurrentIndex + 1} / ${homeItems.length}`;
    }

    if (homeLightboxPhotographer) {
      if (photographer) {
        homeLightboxPhotographer.textContent = `📷 ${photographer}`;
        homeLightboxPhotographer.style.display = 'block';
      } else {
        homeLightboxPhotographer.textContent = '';
        homeLightboxPhotographer.style.display = 'none';
      }
    }
  }

  function openHomeLightbox(index: number) {
    if (!homeLightbox) return;
    homeCurrentIndex = index;
    updateHomeLightbox(homeCurrentIndex);

    homeLightbox.classList.remove('hidden');
    homeLightbox.classList.add('flex');
    requestAnimationFrame(() => {
      homeLightbox.classList.remove('opacity-0');
      homeLightbox.classList.add('opacity-100');
    });

    document.body.style.overflow = 'hidden';
  }

  function closeHomeLightbox() {
    if (!homeLightbox) return;
    homeLightbox.classList.add('opacity-0');
    homeLightbox.classList.remove('opacity-100');
    setTimeout(() => {
      homeLightbox.classList.add('hidden');
      homeLightbox.classList.remove('flex');
      if (homeLightboxImg) homeLightboxImg.src = '';
      document.body.style.overflow = '';
    }, 200);
  }

  function showHomeNext() {
    updateHomeLightbox(homeCurrentIndex + 1);
  }

  function showHomePrev() {
    updateHomeLightbox(homeCurrentIndex - 1);
  }

  homeItems.forEach((item, index) => {
    item.addEventListener('click', () => openHomeLightbox(index));
  });

  homeLightboxNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    showHomeNext();
  });

  homeLightboxPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    showHomePrev();
  });

  homeLightboxClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeHomeLightbox();
  });

  homeLightboxBackdrop?.addEventListener('click', () => {
    closeHomeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (!homeLightbox || homeLightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeHomeLightbox();
    if (e.key === 'ArrowRight') showHomeNext();
    if (e.key === 'ArrowLeft') showHomePrev();
  });
</script>
