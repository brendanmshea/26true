---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { gallery } = raceData;
const homePhotos = (gallery || []).slice(0, 6);
---

<section class="py-20 lg:py-28 bg-black border-t border-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div>
        <h2 class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-2">
          The Experience & Energy
        </h2>
        <p class="font-edo text-4xl sm:text-5xl text-white uppercase tracking-normal">
          Captured In The Streets
        </p>
      </div>
      <a
        href="/gallery"
        class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-[#d4ff00] hover:text-[#3fd4a4] transition-colors"
      >
        <span>View Full Photo Gallery</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Responsive Photo Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {(homePhotos || []).map((photo) => (
        <a
          href="/gallery"
          class="group relative block overflow-hidden rounded-3xl bg-neutral-950 border border-neutral-800 aspect-[4/3]"
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          
          <div class="absolute bottom-0 left-0 right-0 p-6 flex flex-col justify-end">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#d4ff00] text-black">
                {photo.neighborhood}
              </span>
              <span class="text-[10px] font-bold text-neutral-400">
                {photo.year}
              </span>
              {photo.photographer && (
                <span class="text-[10px] text-neutral-400 font-medium ml-auto">
                  📷 {photo.photographer}
                </span>
              )}
            </div>
            <p class="text-xs sm:text-sm font-semibold text-white leading-snug line-clamp-2">
              {photo.caption}
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/gallery"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-2xl text-xs font-black uppercase tracking-wider bg-neutral-900 hover:bg-neutral-800 text-white border border-neutral-800 hover:border-neutral-700 transition-all"
      >
        <span>Browse All Photos in Gallery</span>
        <svg class="w-4 h-4 text-[#d4ff00]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
