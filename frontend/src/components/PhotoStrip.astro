---
// PhotoStrip.astro - Editorial photo showcase for homepage
// Section 1: Merged 5-photo showcase (2 over 3 on desktop, 5-image carousel on mobile + Explore Gallery CTA)
// Section 2: Panoramic breaker photo + Lightbox modal
import { getRaceData } from '../lib/sanity';

interface Props {
  section?: 1 | 2 | 3;
}

const { section = 1 } = Astro.props;

const raceData = await getRaceData();
const { gallery = [] } = raceData;

// Curate photos for the homepage showcase:
// 1. Prioritize photos explicitly marked with "featuredOnHome: true" in Sanity CMS (ordered by display order)
// 2. Gracefully backfill with top gallery photos if fewer than 6 are toggled on
const featuredPhotos = (gallery || [])
  .filter((p: any) => p.featuredOnHome === true)
  .sort((a: any, b: any) => (a.order ?? 10) - (b.order ?? 10));

const unfeaturedPhotos = (gallery || [])
  .filter((p: any) => !p.featuredOnHome)
  .sort((a: any, b: any) => (a.order ?? 10) - (b.order ?? 10));

const showcasePhotos = (
  featuredPhotos.length >= 6
    ? featuredPhotos.slice(0, 6)
    : [...featuredPhotos, ...unfeaturedPhotos].slice(0, 6)
);

// Merged 5 photos for Section 1
const first5Photos = showcasePhotos.slice(0, 5);
const row1Photos = showcasePhotos.slice(0, 2); // 2 photos on top
const row2Photos = showcasePhotos.slice(2, 5); // 3 photos on bottom

// Panoramic photo for Section 2 (Photo 5)
const panoramicPhoto = showcasePhotos[5] || showcasePhotos[0];
---

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{section === 1 && (
  <section aria-label="26.TRUE Photo Showcase" class="py-0 sm:py-6 lg:py-8 bg-black border-t border-neutral-900">
    <div class="max-w-7xl mx-auto px-0 sm:px-6 lg:px-8">
      
      <!-- Mobile Carousel (< sm) - 5-Photo Full-Bleed Carousel -->
      <div class="block sm:hidden relative w-full home-carousel-container select-none overflow-hidden border-b border-neutral-900 sm:border-b-0" data-carousel-id="strip-home-5">
        <div
          class="home-carousel-track flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth w-full"
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="26.TRUE 5-Photo Showcase Carousel"
        >
          {first5Photos.map((photo: any, idx: number) => {
            const originalIndex = idx; // 0, 1, 2, 3, 4
            return (
              <div class="w-full shrink-0 snap-center">
                <button
                  type="button"
                  class="home-photo-open-btn group relative block overflow-hidden bg-neutral-950 aspect-[16/10] w-full text-left cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
                  data-home-photo-index={originalIndex}
                  aria-label={`View photo ${originalIndex + 1} in large view`}
                >
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    loading="lazy"
                    class="h-full w-full object-cover object-center"
                  />
                  <!-- Scrim overlay -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>

                  <!-- Top-Right Expand Icon Badge -->
                  <div class="absolute top-3.5 right-3.5 pointer-events-none z-10">
                    <span class="w-8 h-8 rounded-full bg-black/80 backdrop-blur-md border border-neutral-700 text-[#d4ff00] flex items-center justify-center shadow-lg">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                      </svg>
                    </span>
                  </div>

                  <!-- Top-Left Photographer Badge -->
                  {photo.photographer && (
                    <div class="absolute top-3.5 left-3.5 pointer-events-none z-10">
                      <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold text-neutral-200 bg-black/85 backdrop-blur-md border border-neutral-800 shadow">
                        📷 {photo.photographer}
                      </span>
                    </div>
                  )}
                </button>
              </div>
            );
          })}
        </div>

        <!-- Scrim gradient for controls -->
        <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-black/75 to-transparent pointer-events-none z-10"></div>

        <!-- Navigation Arrows (Mobile) -->
        <button
          type="button"
          class="home-carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/75 hover:bg-black border border-neutral-700/80 text-white hover:text-[#d4ff00] backdrop-blur-md flex items-center justify-center transition-all active:scale-95 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
          aria-label="Previous photo"
        >
          <svg class="w-3.5 h-3.5 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          class="home-carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/75 hover:bg-black border border-neutral-700/80 text-white hover:text-[#d4ff00] backdrop-blur-md flex items-center justify-center transition-all active:scale-95 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
          aria-label="Next photo"
        >
          <svg class="w-3.5 h-3.5 -mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7m0 0l-7 7" />
          </svg>
        </button>

        <!-- Dot Indicators (Mobile) - 5 Dots -->
        <div class="absolute bottom-3 inset-x-0 z-20 flex items-center justify-center gap-1.5 pointer-events-auto">
          {first5Photos.map((_: any, index: number) => (
            <button
              type="button"
              class={`home-carousel-dot h-1.5 rounded-full transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#d4ff00] ${
                index === 0 ? 'w-5 bg-[#d4ff00]' : 'w-1.5 bg-white/40'
              }`}
              data-dot-index={index}
              aria-label={`Go to photo ${index + 1}`}
              aria-current={index === 0 ? "true" : "false"}
            />
          ))}
        </div>
      </div>

      <!-- Desktop 5-Image Layout: 2 over 3 (sm and up) -->
      <div class="hidden sm:block space-y-5" id="home-photo-desktop-5">
        
        <!-- Row 1: 2 Photos (Asymmetric 7 / 5 Grid) -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-12 gap-5" id="home-photo-grid-row1">
          {row1Photos.map((photo: any, idx: number) => {
            const originalIndex = idx; // 0 or 1
            const colSpan = idx === 0 ? 'lg:col-span-7 aspect-[16/10]' : 'lg:col-span-5 aspect-[16/10]';
            return (
              <button
                type="button"
                class={`home-photo-open-btn group relative block overflow-hidden rounded-3xl bg-neutral-950 border border-neutral-800 ${colSpan} w-full text-left cursor-pointer hover:border-[#d4ff00]/60 transition-all duration-300 hover:-translate-y-1 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]`}
                data-home-photo-index={originalIndex}
                aria-label={`View photo ${originalIndex + 1} in large view`}
              >
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading="lazy"
                  class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                
                <!-- Hover Expand Badge -->
                <div class="absolute inset-0 p-5 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                  <div class="flex items-center justify-end">
                    <span class="w-9 h-9 rounded-full bg-black/80 backdrop-blur-md border border-neutral-700 text-[#d4ff00] flex items-center justify-center shadow-lg">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                      </svg>
                    </span>
                  </div>
                  
                  {photo.photographer && (
                    <div>
                      <span class="px-3 py-1 rounded-full text-[11px] font-semibold text-neutral-200 bg-black/85 backdrop-blur-md border border-neutral-800 shadow">
                        📷 {photo.photographer}
                      </span>
                    </div>
                  )}
                </div>
              </button>
            );
          })}
        </div>

        <!-- Row 2: 3 Photos (Equal 3-Column Grid) -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="home-photo-grid-row2">
          {row2Photos.map((photo: any, idx: number) => {
            const originalIndex = idx + 2; // 2, 3, or 4
            return (
              <button
                type="button"
                class="home-photo-open-btn group relative block overflow-hidden rounded-3xl bg-neutral-950 border border-neutral-800 aspect-[4/3] w-full text-left cursor-pointer hover:border-[#d4ff00]/60 transition-all duration-300 hover:-translate-y-1 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
                data-home-photo-index={originalIndex}
                aria-label={`View photo ${originalIndex + 1} in large view`}
              >
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading="lazy"
                  class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                
                <!-- Hover Expand Badge -->
                <div class="absolute inset-0 p-5 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                  <div class="flex items-center justify-end">
                    <span class="w-9 h-9 rounded-full bg-black/80 backdrop-blur-md border border-neutral-700 text-[#d4ff00] flex items-center justify-center shadow-lg">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                      </svg>
                    </span>
                  </div>
                  
                  {photo.photographer && (
                    <div>
                      <span class="px-3 py-1 rounded-full text-[11px] font-semibold text-neutral-200 bg-black/85 backdrop-blur-md border border-neutral-800 shadow">
                        📷 {photo.photographer}
                      </span>
                    </div>
                  )}
                </div>
              </button>
            );
          })}
        </div>

      </div>

      <!-- Explore Gallery CTA Button -->
      <div class="py-5 sm:py-0 sm:mt-6 lg:mt-8 flex justify-center px-4">
        <a
          href="/gallery"
          class="inline-flex items-center gap-2.5 px-6 sm:px-7 py-3 sm:py-3.5 rounded-2xl text-xs sm:text-sm font-black uppercase tracking-wider bg-neutral-900 hover:bg-neutral-800 text-[#d4ff00] hover:text-[#3fd4a4] border border-neutral-800 hover:border-neutral-700 shadow-xl transition-all transform hover:-translate-y-0.5"
        >
          <span>Explore Full Gallery ({gallery?.length || 7} Photos)</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

    </div>
  </section>
)}

{(section === 2 || section === 3) && (
  <section aria-label="26.TRUE Photo Showcase Panoramic" class="py-0 sm:py-6 lg:py-8 bg-black border-t border-neutral-900">
    <div class="max-w-7xl mx-auto px-0 sm:px-6 lg:px-8">
      <!-- Panoramic Photo 5 -->
      <button
        type="button"
        class="home-photo-open-btn group relative block overflow-hidden rounded-none sm:rounded-3xl bg-neutral-950 border-b border-neutral-900 sm:border sm:border-neutral-800 w-full aspect-[16/10] sm:aspect-[21/9] text-left cursor-pointer hover:border-[#d4ff00]/60 transition-all duration-300 hover:-translate-y-1 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
        data-home-photo-index={5}
        aria-label="View photo 6 in large view"
      >
        <img
          src={panoramicPhoto.src}
          alt={panoramicPhoto.alt}
          loading="lazy"
          class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 sm:group-hover:opacity-100 transition-opacity duration-300"></div>
        
        <!-- Expand Badge -->
        <div class="absolute inset-0 p-4 sm:p-7 flex flex-col justify-between sm:opacity-0 sm:group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
          <div class="flex items-center justify-end">
            <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/80 backdrop-blur-md border border-neutral-700 text-[#d4ff00] flex items-center justify-center shadow-lg">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
              </svg>
            </span>
          </div>
          
          {panoramicPhoto.photographer && (
            <div>
              <span class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[10px] sm:text-xs font-semibold text-neutral-200 bg-black/85 backdrop-blur-md border border-neutral-800 shadow">
                📷 {panoramicPhoto.photographer}
              </span>
            </div>
          )}
        </div>
      </button>
    </div>

    <!-- Curated Homepage Photos Data for Lightbox Modal -->
    <script id="home-showcase-data" type="application/json" set:html={JSON.stringify(showcasePhotos)} />

    <!-- Lightbox Modal for Homepage Photos (Rendered with Section 2) -->
    <div
      id="home-photo-lightbox"
      class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300 select-none items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-label="Photo Lightbox"
    >
      <div id="home-lightbox-backdrop" class="absolute inset-0 bg-black/95 backdrop-blur-xl"></div>

      <!-- Top bar -->
      <div class="absolute top-0 inset-x-0 z-30 p-4 sm:p-6 flex items-center justify-between pointer-events-none">
        <div class="pointer-events-auto flex items-center gap-2.5 px-4 py-2 rounded-full bg-neutral-900/90 border border-neutral-800 text-xs font-bold text-neutral-300 shadow-xl">
          <span class="text-[#d4ff00] uppercase tracking-wider font-black">26.TRUE</span>
          <span id="home-lightbox-counter" class="text-white">1 / 6</span>
        </div>

        <button
          id="home-lightbox-close"
          type="button"
          class="pointer-events-auto w-11 h-11 rounded-full bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 hover:text-white flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
          aria-label="Close photo view (Esc)"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Previous Button -->
      <button
        id="home-lightbox-prev"
        type="button"
        class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-black/85 hover:bg-neutral-900 border border-neutral-700/80 text-white hover:text-[#d4ff00] flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
        aria-label="Previous photo (Left arrow)"
      >
        <svg class="w-6 h-6 sm:w-7 sm:h-7 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Next Button -->
      <button
        id="home-lightbox-next"
        type="button"
        class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-black/85 hover:bg-neutral-900 border border-neutral-700/80 text-white hover:text-[#d4ff00] flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
        aria-label="Next photo (Right arrow)"
      >
        <svg class="w-6 h-6 sm:w-7 sm:h-7 -mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7m0 0l-7 7"/>
        </svg>
      </button>

      <!-- Main Image Presentation Stage -->
      <div class="relative z-20 w-full h-full flex flex-col items-center justify-center p-4 sm:p-12 pointer-events-none">
        <div class="relative pointer-events-auto max-h-[82vh] max-w-[90vw] flex flex-col items-center">
          <img
            id="home-lightbox-img"
            src=""
            alt=""
            class="max-h-[76vh] sm:max-h-[80vh] max-w-[92vw] sm:max-w-[85vw] object-contain rounded-2xl shadow-2xl border border-neutral-800/80 transition-transform duration-200"
          />
          <div id="home-lightbox-photographer" class="mt-3 text-center text-xs font-semibold text-neutral-400"></div>
        </div>
      </div>
    </div>
  </section>
)}

<script>
  // Mobile Carousels Controller
  function setupHomeCarousels() {
    const containers = Array.from(document.querySelectorAll<HTMLElement>('.home-carousel-container'));

    containers.forEach((container) => {
      const track = container.querySelector<HTMLElement>('.home-carousel-track');
      const prevBtn = container.querySelector<HTMLButtonElement>('.home-carousel-prev');
      const nextBtn = container.querySelector<HTMLButtonElement>('.home-carousel-next');
      const dots = Array.from(container.querySelectorAll<HTMLButtonElement>('.home-carousel-dot'));

      if (!track || dots.length <= 1) return;

      // Track touch drag vs tap to prevent opening lightbox on swipe
      let startX = 0;
      let startY = 0;
      let isDragging = false;

      track.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        isDragging = false;
        container.dataset.swiping = 'false';
      }, { passive: true });

      track.addEventListener('touchmove', (e) => {
        const dx = Math.abs(e.touches[0].clientX - startX);
        const dy = Math.abs(e.touches[0].clientY - startY);
        if (dx > 8 || dy > 8) {
          isDragging = true;
          container.dataset.swiping = 'true';
        }
      }, { passive: true });

      track.addEventListener('touchend', () => {
        if (isDragging) {
          setTimeout(() => {
            container.dataset.swiping = 'false';
          }, 120);
        }
      });

      // Update dots on scroll
      let scrollRaf: number | null = null;
      function updateDots() {
        if (!track) return;
        const width = track.clientWidth || 1;
        const currentIdx = Math.round(track.scrollLeft / width);

        dots.forEach((dot, idx) => {
          const isActive = idx === currentIdx;
          if (isActive) {
            dot.classList.remove('w-1.5', 'bg-white/40');
            dot.classList.add('w-5', 'bg-[#d4ff00]');
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.classList.remove('w-5', 'bg-[#d4ff00]');
            dot.classList.add('w-1.5', 'bg-white/40');
            dot.setAttribute('aria-current', 'false');
          }
        });
      }

      track.addEventListener('scroll', () => {
        if (scrollRaf) cancelAnimationFrame(scrollRaf);
        scrollRaf = requestAnimationFrame(updateDots);
      }, { passive: true });

      // Click dots
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const width = track.clientWidth || 0;
          track.scrollTo({ left: idx * width, behavior: 'smooth' });
        });
      });

      // Prev / Next button actions
      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const width = track.clientWidth || 0;
        const currentIdx = Math.round(track.scrollLeft / width);
        const targetIdx = currentIdx <= 0 ? dots.length - 1 : currentIdx - 1;
        track.scrollTo({ left: targetIdx * width, behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const width = track.clientWidth || 0;
        const currentIdx = Math.round(track.scrollLeft / width);
        const targetIdx = currentIdx >= dots.length - 1 ? 0 : currentIdx + 1;
        track.scrollTo({ left: targetIdx * width, behavior: 'smooth' });
      });
    });
  }

  // Unified Full-Screen Lightbox Controller
  function setupHomepageLightbox() {
    const dataScript = document.getElementById('home-showcase-data');
    let photosList: any[] = [];
    try {
      photosList = dataScript ? JSON.parse(dataScript.textContent || '[]') : [];
    } catch {
      photosList = [];
    }

    const homeLightbox = document.getElementById('home-photo-lightbox');
    const homeLightboxBackdrop = document.getElementById('home-lightbox-backdrop');
    const homeLightboxImg = document.getElementById('home-lightbox-img') as HTMLImageElement | null;
    const homeLightboxCounter = document.getElementById('home-lightbox-counter');
    const homeLightboxPhotographer = document.getElementById('home-lightbox-photographer');
    const homeLightboxClose = document.getElementById('home-lightbox-close');
    const homeLightboxPrev = document.getElementById('home-lightbox-prev');
    const homeLightboxNext = document.getElementById('home-lightbox-next');

    if (!homeLightbox) return;

    let homeCurrentIndex = 0;

    function updateHomeLightbox(index: number) {
      if (!photosList.length || !homeLightboxImg) return;

      if (index < 0) {
        homeCurrentIndex = photosList.length - 1;
      } else if (index >= photosList.length) {
        homeCurrentIndex = 0;
      } else {
        homeCurrentIndex = index;
      }

      const photo = photosList[homeCurrentIndex];
      if (!photo) return;

      homeLightboxImg.src = photo.src;
      homeLightboxImg.alt = photo.alt || '26.TRUE Photo';

      if (homeLightboxCounter) {
        homeLightboxCounter.textContent = `${homeCurrentIndex + 1} / ${photosList.length}`;
      }

      if (homeLightboxPhotographer) {
        if (photo.photographer) {
          homeLightboxPhotographer.textContent = `📷 ${photo.photographer}`;
          homeLightboxPhotographer.style.display = 'block';
        } else {
          homeLightboxPhotographer.textContent = '';
          homeLightboxPhotographer.style.display = 'none';
        }
      }
    }

    function openHomeLightbox(index: number) {
      if (!homeLightbox) return;
      homeCurrentIndex = index;
      updateHomeLightbox(homeCurrentIndex);

      homeLightbox.classList.remove('hidden');
      homeLightbox.classList.add('flex');
      requestAnimationFrame(() => {
        homeLightbox.classList.remove('opacity-0');
        homeLightbox.classList.add('opacity-100');
      });

      document.body.style.overflow = 'hidden';
    }

    function closeHomeLightbox() {
      if (!homeLightbox) return;
      homeLightbox.classList.add('opacity-0');
      homeLightbox.classList.remove('opacity-100');
      setTimeout(() => {
        homeLightbox.classList.add('hidden');
        homeLightbox.classList.remove('flex');
        if (homeLightboxImg) homeLightboxImg.src = '';
        document.body.style.overflow = '';
      }, 200);
    }

    function showHomeNext() {
      updateHomeLightbox(homeCurrentIndex + 1);
    }

    function showHomePrev() {
      updateHomeLightbox(homeCurrentIndex - 1);
    }

    // Attach click listeners to all photo buttons across mobile carousels and desktop grids
    const openButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.home-photo-open-btn'));
    openButtons.forEach((btn) => {
      btn.onclick = (e) => {
        const container = btn.closest<HTMLElement>('.home-carousel-container');
        if (container && container.dataset.swiping === 'true') {
          e.preventDefault();
          return;
        }
        const idx = parseInt(btn.getAttribute('data-home-photo-index') || '0', 10);
        openHomeLightbox(idx);
      };
    });

    homeLightboxNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      showHomeNext();
    });

    homeLightboxPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      showHomePrev();
    });

    homeLightboxClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeHomeLightbox();
    });

    homeLightboxBackdrop?.addEventListener('click', () => {
      closeHomeLightbox();
    });

    window.addEventListener('keydown', (e) => {
      if (!homeLightbox || homeLightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeHomeLightbox();
      if (e.key === 'ArrowRight') showHomeNext();
      if (e.key === 'ArrowLeft') showHomePrev();
    });

    // Touch swipe gestures inside the full-screen lightbox modal
    let lbTouchStartX = 0;
    let lbTouchStartY = 0;

    homeLightbox.addEventListener('touchstart', (e) => {
      lbTouchStartX = e.touches[0].clientX;
      lbTouchStartY = e.touches[0].clientY;
    }, { passive: true });

    homeLightbox.addEventListener('touchend', (e) => {
      const diffX = e.changedTouches[0].clientX - lbTouchStartX;
      const diffY = e.changedTouches[0].clientY - lbTouchStartY;

      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
        if (diffX < 0) {
          showHomeNext();
        } else {
          showHomePrev();
        }
      } else if (diffY > 80 && Math.abs(diffY) > Math.abs(diffX)) {
        closeHomeLightbox();
      }
    }, { passive: true });
  }

  function init() {
    setupHomeCarousels();
    setupHomepageLightbox();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('astro:page-load', init);
</script>
