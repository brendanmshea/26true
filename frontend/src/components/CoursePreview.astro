---
import { raceData } from '../data/raceData';
const { course } = raceData;
---

<section class="py-20 lg:py-28 bg-black border-y border-neutral-900 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left description -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#d4ff00] text-black">
          The Neighborhood Route
        </div>
        <h2 class="font-edo text-4xl sm:text-5xl text-white uppercase tracking-normal">
          Through Boston's Cultural Heart
        </h2>
        <p class="text-neutral-300 text-base leading-relaxed font-normal">
          26.TRUE is an authentic tour of Boston. We run through Roxbury, Dorchester, Mattapan, Jamaica Plain, Hyde Park, and the South End — passing historic parks, local businesses, and community centers with block-party cheer squads lining the way.
        </p>

        <!-- Neighborhood tags -->
        <div class="flex flex-wrap gap-2 pt-2">
          {course.neighborhoods.map((n) => (
            <span class="px-3 py-1 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 text-neutral-300 border border-neutral-800">
              {n.name}
            </span>
          ))}
        </div>

        <div class="pt-4">
          <a
            href="/course"
            class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-wider text-[#d4ff00] hover:text-[#3fd4a4] transition-colors group"
          >
            <span>View Full Route & All Cheer Stations</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right visual card -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="w-full max-w-md bg-neutral-950 rounded-3xl border border-neutral-800 p-8 relative shadow-2xl flex flex-col items-center text-center">
          <img
            src="/images/race_locations_logo.png"
            alt="26.TRUE Route Footprint"
            class="w-full max-w-[320px] h-auto object-contain mb-6 drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)]"
          />
          <div class="w-full pt-4 border-t border-neutral-900 flex items-center justify-between text-xs">
            <span class="font-bold text-neutral-400">Marathon (26.2) & Half (13.1)</span>
            <span class="font-black text-[#3fd4a4] uppercase">100% City of Boston</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
