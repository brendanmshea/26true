---
import { raceData } from '../data/raceData';
const { course } = raceData;
---

<section class="relative py-20 lg:py-28 bg-black border-y border-neutral-900 overflow-hidden">
  <!-- Subtle Background Photo with Dark Scrim -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <img
      src="/images/photos/web/1Q7A3679.jpg"
      alt="26.TRUE runners touring Boston corridors"
      class="w-full h-full object-cover object-center opacity-20 filter brightness-50 contrast-125"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/95 to-black/80"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left description -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#d4ff00] text-black">
          The Neighborhood Route
        </div>
        <h2 class="font-edo text-4xl sm:text-5xl text-white uppercase tracking-normal">
          Through Boston's Cultural Heart
        </h2>
        <p class="text-neutral-300 text-base leading-relaxed font-normal">
          26.TRUE is an authentic tour of Boston. We run entirely within city limits through <strong class="text-white">Jamaica Plain, Roxbury, Mattapan, and Dorchester</strong> — passing historic parks, community landmarks, and 6 vibrant Cheer Zones with live music and block-party energy.
        </p>

        <!-- The 4 Neighborhood pills -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          {course.neighborhoods.map((n) => (
            <div class="p-3.5 rounded-2xl bg-black/85 border border-neutral-800 backdrop-blur-md">
              <span class="font-edo text-lg text-white block">{n.name}</span>
              <span class="text-[11px] text-neutral-400 leading-tight block mt-0.5">{n.highlight}</span>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href="/course"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] transition-colors"
          >
            <span>Full Course & Cheer Guide</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href={course.stravaRouteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-black/80 hover:bg-neutral-900 border border-neutral-800 transition-colors"
          >
            <span class="text-[#fc4c02] font-black">Strava</span>
            <span>Route</span>
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Official 26.TRUE Race Logo Display Card -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="w-full max-w-lg bg-black/90 rounded-3xl border border-neutral-800 p-6 sm:p-8 shadow-2xl backdrop-blur-md overflow-hidden group hover:border-[#d4ff00]/40 transition-all flex flex-col items-center text-center relative">
          
          <!-- Subtle neon glow accents -->
          <div class="absolute -top-16 -right-16 w-44 h-44 bg-[#d4ff00]/15 blur-3xl rounded-full pointer-events-none"></div>
          <div class="absolute -bottom-16 -left-16 w-44 h-44 bg-[#3fd4a4]/15 blur-3xl rounded-full pointer-events-none"></div>

          <!-- Top Badge Bar -->
          <div class="w-full flex items-center justify-between mb-4 pb-3 border-b border-neutral-900">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#d4ff00] text-black">
              Official Identity
            </span>
            <span class="text-[11px] font-bold text-neutral-400">
              Year Seven &bull; 2027
            </span>
          </div>

          <!-- Main Race Logo -->
          <div class="relative py-6 px-4 flex items-center justify-center w-full">
            <img
              src="/images/race_logo.png"
              alt="26.TRUE Marathon & Half Marathon Official Logo"
              class="w-full max-w-[260px] sm:max-w-[300px] h-auto object-contain drop-shadow-[0_10px_30px_rgba(212,255,0,0.25)] group-hover:scale-105 transition-transform duration-500"
            />
          </div>

          <!-- Card Footer Info -->
          <div class="w-full pt-4 border-t border-neutral-900 flex items-center justify-between text-xs">
            <span class="font-bold text-white flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#3fd4a4]"></span>
              6 Dedicated Cheer Zones Stationed Every 2–3 Miles
            </span>
            <a href="/course" class="text-[11px] font-bold text-[#d4ff00] hover:underline flex items-center gap-1">
              <span>View Map</span>
              &rarr;
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
