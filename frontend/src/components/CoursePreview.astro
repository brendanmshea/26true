---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { course } = raceData;

const neighborhoodImages: Record<string, string> = {
  'Jamaica Plain': '/images/photos/web/1Q7A3679.jpg',
  'Roxbury': '/images/photos/web/26true2026©CharlotteTuminelli-3075.jpg',
  'Mattapan': '/images/photos/web/20260418_26.True Marathon_@ShotByEK-187.JPG',
  'Dorchester': '/images/photos/web/562A8170.jpg',
};
---

<section class="relative py-8 sm:py-10 lg:py-12 bg-black border-y border-neutral-900 overflow-hidden">
  <!-- Subtle Background Photo with Dark Scrim -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <img
      src="/images/photos/web/1Q7A3679.jpg"
      alt="26.TRUE runners touring Boston corridors"
      class="w-full h-full object-cover object-center opacity-20 filter brightness-50 contrast-125"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/95 to-black/80"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left description -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#d4ff00] text-black">
          The Neighborhood Route
        </div>
        <h2 class="font-edo text-4xl sm:text-5xl text-white uppercase tracking-normal">
          Through Boston's Cultural Heart
        </h2>
        <p class="text-neutral-300 text-base leading-relaxed font-normal">
          26.TRUE is an authentic tour of Boston. We run through <strong class="text-white">Jamaica Plain, Roxbury, Mattapan, and Dorchester</strong> — passing historic parks, community landmarks, and vibrant Cheer Zones.
        </p>

        <!-- The 4 Neighborhood visual cards -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          {(course?.neighborhoods || []).map((n) => {
            const photo = neighborhoodImages[n.name] || '/images/photos/web/1Q7A3679.jpg';

            return (
              <div class="group relative overflow-hidden rounded-2xl p-4 border border-neutral-800 bg-neutral-950 shadow-lg hover:border-[#d4ff00]/50 transition-all hover:-translate-y-0.5">
                <img
                  src={photo}
                  alt={n.name}
                  class="absolute inset-0 w-full h-full object-cover object-center filter brightness-60 contrast-125 transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/85 to-black/40"></div>
                
                <div class="relative z-10">
                  <span class="font-edo text-lg text-white block group-hover:text-[#d4ff00] transition-colors drop-shadow">{n.name}</span>
                  <span class="text-[11px] text-neutral-200 leading-tight block mt-0.5 font-normal drop-shadow">{n.highlight}</span>
                </div>
              </div>
            );
          })}
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href="/course"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] transition-colors"
          >
            <span>Full Course & Cheer Guide</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href={course.stravaRouteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-black/80 hover:bg-neutral-900 border border-neutral-800 transition-colors"
          >
            <span class="text-[#fc4c02] font-black">Strava</span>
            <span>Route</span>
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Course Map Embed -->
      <div class="lg:col-span-7">
        <div class="bg-black/90 rounded-3xl border border-neutral-800 p-4 sm:p-6 shadow-2xl backdrop-blur-md overflow-hidden">
          
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-neutral-800">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-[#3fd4a4]">Interactive Course Map</span>
              <h3 class="font-edo text-xl text-white">Full & Half Marathon Routes</h3>
            </div>
            <a
              href={course.googleMapsViewerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] font-bold text-[#d4ff00] hover:underline flex items-center gap-1"
            >
              <span>Open in Google Maps</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>

          <!-- Google Maps Iframe Embed -->
          <div class="w-full h-80 sm:h-96 rounded-2xl overflow-hidden border border-neutral-800 relative bg-neutral-900">
            <iframe
              src={course.googleMapsEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="26.TRUE Official Course Map"
            ></iframe>
          </div>

          <div class="mt-4 pt-4 border-t border-neutral-900 flex flex-wrap items-center justify-between gap-3 text-xs text-neutral-400">
            <span class="font-bold text-white flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#3fd4a4]"></span>
              6 Dedicated Cheer Zones Stationed Every 2–3 Miles
            </span>
            <span class="font-mono text-[11px]">Jamaica Plain &bull; Roxbury &bull; Mattapan &bull; Dorchester</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
