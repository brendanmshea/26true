---
import { raceData } from '../data/raceData';
const { faqs, general } = raceData;

interface Props {
  limit?: number;
  showCategoryHeaders?: boolean;
}

const { limit, showCategoryHeaders = false } = Astro.props;
const displayFaqs = limit ? faqs.slice(0, limit) : faqs;
---

<section class="py-20 lg:py-28 bg-slate-950">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3">
        Got Questions?
      </h2>
      <p class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        Frequently Asked Questions
      </p>
      <p class="text-sm text-slate-400 mt-3">
        Everything you need to know about registration, course rules, packet pickup, and race morning.
      </p>
    </div>

    <div class="space-y-4">
      {displayFaqs.map((faq) => (
        <details class="group bg-slate-900/40 border border-slate-800/80 rounded-2xl overflow-hidden transition-all [&[open]]:border-emerald-500/40 [&[open]]:bg-slate-900/70">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
            <span class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors pr-4">
              {faq.question}
            </span>
            <span class="shrink-0 w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 group-hover:text-white transition-colors group-open:rotate-180 transition-transform duration-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-sm text-slate-300 leading-relaxed border-t border-slate-800/50 pt-4">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    {limit && (
      <div class="mt-12 text-center">
        <a
          href="/faq"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-slate-900 hover:bg-slate-800 text-white border border-slate-800 transition-all"
        >
          <span>View All Frequently Asked Questions</span>
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    )}

    <!-- Have more questions box -->
    <div class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 text-center">
      <h3 class="text-lg font-bold text-white mb-2">Still have questions?</h3>
      <p class="text-xs sm:text-sm text-slate-400 max-w-md mx-auto mb-6">
        Our race operations committee is here to assist. Drop us a note anytime and we'll get back to you within 24 hours.
      </p>
      <a
        href={`mailto:${general.contactEmail}`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-400 hover:bg-emerald-300 text-slate-950 transition-colors"
      >
        <span>Contact Race Directors ({general.contactEmail})</span>
      </a>
    </div>

  </div>
</section>
