---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { faqs, general } = raceData;

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const displayFaqs = limit ? faqs.slice(0, limit) : faqs;
---

<section class="py-20 lg:py-28 bg-black">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-3">
        Got Questions?
      </h2>
      <p class="font-edo text-4xl sm:text-5xl text-white uppercase tracking-normal">
        Frequently Asked Questions
      </p>
      <p class="text-sm text-neutral-400 mt-3 max-w-lg mx-auto">
        Everything you need to know about the untimed format, neighborhood route, cheer squads, and bib pickup.
      </p>
    </div>

    <div class="space-y-4">
      {displayFaqs.map((faq) => (
        <details class="group bg-neutral-950 border border-neutral-800/80 rounded-2xl overflow-hidden transition-all [&[open]]:border-[#d4ff00]/40">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
            <span class="text-base font-bold text-white group-hover:text-[#d4ff00] transition-colors pr-4">
              {faq.question}
            </span>
            <span class="shrink-0 w-8 h-8 rounded-full bg-neutral-900 flex items-center justify-center text-neutral-400 group-hover:text-white transition-colors group-open:rotate-180 transition-transform duration-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-sm text-neutral-300 leading-relaxed border-t border-neutral-900 pt-4">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    {limit && (
      <div class="mt-12 text-center">
        <a
          href="/faq"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl text-xs font-black uppercase tracking-wider bg-neutral-900 hover:bg-neutral-800 text-white border border-neutral-800 hover:border-neutral-700 transition-all"
        >
          <span>View All Frequently Asked Questions</span>
          <svg class="w-4 h-4 text-[#d4ff00]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    )}

    <!-- Have more questions box -->
    <div class="mt-16 p-8 rounded-3xl bg-neutral-950 border border-neutral-800 text-center">
      <h3 class="font-edo text-2xl text-white uppercase mb-2">Still have questions?</h3>
      <p class="text-xs sm:text-sm text-neutral-400 max-w-md mx-auto mb-6">
        Our crew is here to assist. Drop us a note anytime and we'll get right back to you.
      </p>
      <a
        href={`mailto:${general.contactEmail}`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-black uppercase tracking-wider bg-[#d4ff00] hover:bg-[#c3ec00] text-black transition-colors"
      >
        <span>Contact The Crew ({general.contactEmail})</span>
      </a>
    </div>

  </div>
</section>
