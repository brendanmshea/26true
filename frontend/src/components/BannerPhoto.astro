---
// BannerPhoto.astro - Full-bleed photo banner showcasing 26.TRUE runners
---

<section aria-label="26.TRUE Community Photo Banner" class="relative w-full bg-black overflow-hidden border-b border-neutral-900">
  <div class="relative w-full max-w-7xl mx-auto overflow-hidden bg-neutral-950">
    <!-- Responsive Picture Element: Mobile optimized (272KB) -> Desktop optimized (934KB) -->
    <picture>
      <source media="(max-width: 640px)" srcset="/images/photos/web/banner-mobile.jpg" />
      <img
        src="/images/photos/web/banner.jpg"
        alt="26.TRUE community runners taking to Boston streets with joy and energy"
        class="w-full h-auto max-h-[520px] lg:max-h-[560px] object-cover object-center block"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>
</section>
