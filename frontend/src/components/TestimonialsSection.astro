---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { testimonials } = raceData;
---

<section class="relative py-20 lg:py-28 bg-black overflow-hidden border-t border-neutral-900">
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-3">
        The People's Race
      </h2>
      <p class="font-edo text-4xl sm:text-5xl text-white uppercase tracking-normal">
        Voices From The Course
      </p>
      <p class="text-sm text-neutral-400 mt-3 max-w-lg mx-auto">
        What runners, first-timers, and volunteer cheer squads say about running Boston our way.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {(testimonials || []).map((t) => (
        <div class="bg-neutral-950/90 border border-neutral-800 rounded-3xl p-8 flex flex-col justify-between backdrop-blur-md hover:border-[#d4ff00]/40 transition-colors shadow-xl">
          <div class="mb-6">
            <svg class="w-8 h-8 text-[#d4ff00] mb-4 opacity-75" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <p class="text-sm sm:text-base text-neutral-200 leading-relaxed font-normal">
              &ldquo;{t.quote}&rdquo;
            </p>
          </div>
          <div class="pt-4 border-t border-neutral-900 flex items-center justify-between">
            <span class="text-xs font-black uppercase text-white tracking-wider">{t.author}</span>
            <span class="text-[11px] font-bold uppercase text-[#3fd4a4] tracking-wide">{t.role}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
