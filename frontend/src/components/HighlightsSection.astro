---
import { raceData } from '../data/raceData';
const { highlights } = raceData;
---

<section class="py-20 lg:py-28 bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3">
        Engineered For Runners
      </h2>
      <p class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        Everything You Need To Chase Your Personal Best
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {highlights.map((item, index) => (
        <div class="bg-slate-900/40 border border-slate-800/80 hover:border-slate-700 rounded-3xl p-8 flex flex-col justify-between transition-all hover:-translate-y-1">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-lg mb-6">
              0{index + 1}
            </div>
            <h3 class="text-xl font-bold text-white mb-3 tracking-tight">
              {item.title}
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-800/50 flex items-center gap-2 text-xs font-semibold text-emerald-400">
            <span>Learn more</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
