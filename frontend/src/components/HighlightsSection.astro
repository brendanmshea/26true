---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { pillars } = raceData;

const pillarImages = [
  '/images/photos/web/1Q7A3679.jpg',                           // 01 Our City, Our Way - Boston neighborhood corridors
  '/images/photos/web/26true2026©CharlotteTuminelli-3075.jpg', // 02 Untimed & Inclusive - joy, connection & smiling runners
  '/images/photos/web/1Q7A3259.jpg',                           // 03 Cheer Zones - crowds, energy & cheer squads
  '/images/photos/web/562A8170.jpg',                           // 04 Founded by PIONEERS - PIONEERS crew solidarity in Dorchester
];
---

<section class="relative py-6 sm:py-10 lg:py-12 bg-black overflow-hidden border-t border-neutral-900">
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {(pillars || []).map((item, index) => {
        const linkUrl = item.linkUrl || '/history';
        const linkLabel = item.linkLabel || 'Read the history';
        const isExternal = linkUrl.startsWith('http');
        const bgPhoto = pillarImages[index % pillarImages.length];

        return (
          <div class="group relative overflow-hidden rounded-3xl border border-neutral-800/80 hover:border-[#d4ff00]/60 p-5 sm:p-7 lg:p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 shadow-2xl min-h-0 sm:min-h-[340px]">
            <!-- Photography Background with Cinematic Scrim -->
            <img
              src={bgPhoto}
              alt={item.title}
              class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105 filter brightness-90"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/85 to-black/50 transition-opacity duration-300 group-hover:opacity-90"></div>
            <div class="absolute inset-0 bg-black/30 group-hover:bg-transparent transition-colors duration-500"></div>

            <div class="relative z-10">
              <h3 class="font-edo text-xl sm:text-2xl text-white mb-2 sm:mb-3 tracking-normal group-hover:text-[#3fd4a4] transition-colors drop-shadow-md">
                <a
                  href={linkUrl}
                  class="hover:underline"
                  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {item.title}
                </a>
              </h3>
              <p class="text-xs sm:text-sm text-neutral-200 leading-relaxed font-normal drop-shadow">
                {item.description}
              </p>
            </div>
            
            <div class="relative z-10 mt-4 sm:mt-8 pt-3 sm:pt-4 border-t border-white/10 flex items-center gap-2 text-xs font-bold text-[#d4ff00]">
              <a
                href={linkUrl}
                class="hover:underline flex items-center gap-1.5 group-hover:gap-2.5 transition-all drop-shadow"
                {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span>{linkLabel}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
