---
import { getRaceData } from '../lib/sanity';
const raceData = await getRaceData();
const { pillars } = raceData;
---

<section class="relative py-20 lg:py-28 bg-black overflow-hidden">
  <!-- Subtle Background Photo (PIONEERS Crew) with Dark Scrim -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <img
      src="/images/photos/web/562A8170.jpg"
      alt="PIONEERS Run Crew Community"
      class="w-full h-full object-cover object-center opacity-20 filter grayscale contrast-125 brightness-50"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-black"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-3">
        Why We Run 26.TRUE
      </h2>
      <p class="font-edo text-4xl sm:text-5xl text-white uppercase tracking-normal">
        Reclaiming The Distance In Our Neighborhoods
      </p>
      <p class="text-sm sm:text-base text-neutral-300 mt-4 max-w-xl mx-auto font-normal">
        More than 26.2 miles — it is a movement of representation, culture, and collective pride through the heart of Boston.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {(pillars || []).map((item, index) => (
        <div class="bg-black/85 border border-neutral-800/80 hover:border-neutral-700 rounded-3xl p-8 flex flex-col justify-between backdrop-blur-md transition-all hover:-translate-y-1 group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-neutral-900/90 border border-neutral-800 text-[#d4ff00] flex items-center justify-center font-edo text-xl mb-6 group-hover:border-[#d4ff00]/50 transition-colors">
              0{index + 1}
            </div>
            <h3 class="font-edo text-2xl text-white mb-3 tracking-normal group-hover:text-[#3fd4a4] transition-colors">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-neutral-900 flex items-center gap-2 text-xs font-bold text-[#d4ff00]">
            <a href="/history" class="hover:underline flex items-center gap-1.5">
              <span>Read the history</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
