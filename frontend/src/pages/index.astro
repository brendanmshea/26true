---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import RaceStats from '../components/RaceStats.astro';
import HighlightsSection from '../components/HighlightsSection.astro';
import CoursePreview from '../components/CoursePreview.astro';
import ScheduleSection from '../components/ScheduleSection.astro';
import SponsorGrid from '../components/SponsorGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { raceData } from '../data/raceData';

const { general } = raceData;
---

<Layout>
  <!-- Hero with Live Countdown -->
  <Hero />

  <!-- 4 Key Numbers -->
  <RaceStats />

  <!-- Why Run 26True -->
  <HighlightsSection />

  <!-- Course Elevation & Aid Preview -->
  <CoursePreview />

  <!-- Weekend Timeline -->
  <ScheduleSection />

  <!-- FAQ Accordion (Top 4 FAQs) -->
  <FaqAccordion limit={4} />

  <!-- Big Pre-Footer CTA -->
  <section class="py-20 lg:py-28 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border-t border-slate-800 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-15 pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-500 blur-[140px] rounded-full"></div>
    </div>
    
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30 mb-6">
        {general.registrationStatus}
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight mb-6">
        Ready To Put Your Training To The Test?
      </h2>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Join 3,500 runners on the starting line this October. Field size is strictly capped to guarantee open roads and personal space for your fastest possible 26.2.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={general.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-extrabold text-slate-950 bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 rounded-2xl shadow-xl shadow-emerald-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Register on RunSignup</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <a
          href="/faq"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-bold text-white bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-2xl transition-all"
        >
          <span>Read Runner FAQ</span>
        </a>
      </div>

      <div class="mt-8 text-xs text-slate-400">
        Prices increase on {general.priceIncreaseDate} or when tier 1 sells out.
      </div>
    </div>
  </section>

  <!-- Partners & Sponsors -->
  <SponsorGrid />
</Layout>
