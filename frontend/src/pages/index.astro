---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import RaceStats from '../components/RaceStats.astro';
import HighlightsSection from '../components/HighlightsSection.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import CoursePreview from '../components/CoursePreview.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { raceData } from '../data/raceData';

const { general } = raceData;
---

<Layout>
  <!-- Hero with Live Countdown & Jacket Artwork -->
  <Hero />

  <!-- 4 Untimed & Community Metrics -->
  <RaceStats />

  <!-- Why We Run 26.TRUE -->
  <HighlightsSection />

  <!-- Photo Strip / Community Energy Showcase -->
  <PhotoStrip />

  <!-- Boston Neighborhood Route Teaser -->
  <CoursePreview />

  <!-- Top Frequently Asked Questions -->
  <FaqAccordion limit={4} />

  <!-- Big Pre-Footer CTA -->
  <section class="py-20 lg:py-28 bg-black border-t border-neutral-900 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-15 pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-[#d4ff00] blur-[150px] rounded-full"></div>
    </div>
    
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#d4ff00] text-black mb-6">
        {general.registrationStatus}
      </div>
      
      <h2 class="font-edo text-4xl sm:text-6xl text-white uppercase tracking-normal mb-6">
        Ready To Run Boston Our Way?
      </h2>
      
      <p class="text-base sm:text-lg text-neutral-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Experience 26.2 or 13.1 miles through the historic streets, sounds, and heartbeat of Boston. An unforgettable celebration of community, culture, and collective grit.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={general.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-sm font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] rounded-2xl shadow-xl shadow-[#d4ff00]/20 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Register on RunSignup</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <a
          href="/history"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-bold uppercase tracking-wider text-white bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 rounded-2xl transition-all"
        >
          <span>Read The Origin Story</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
