---
import Layout from '../layouts/Layout.astro';
import { raceData } from '../data/raceData';

const { faqs, general } = raceData;

const categories = ['All', 'Registration', 'Race Day Logistics', 'Course & Rules', 'Spectators & Volunteers'];
---

<Layout
  title={`Runner FAQ & Rules — ${general.name}`}
  description="Frequently asked questions about 26True registration, bib transfers, gear check, time cutoffs, and parking."
>
  <section class="bg-slate-950 py-16 lg:py-24 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30 mb-4">
          Runner Knowledge Base
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Clear answers to help you prepare for a seamless, stress-free race weekend.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mb-12" id="faq-filter-bar">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`faq-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all ${
              idx === 0
                ? 'bg-emerald-400 text-slate-950 shadow-md shadow-emerald-500/20 active-cat'
                : 'bg-slate-900 text-slate-300 hover:text-white border border-slate-800'
            }`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- FAQ Items List -->
      <div class="space-y-4" id="faq-list">
        {faqs.map((faq) => (
          <details
            class="faq-item group bg-slate-900/40 border border-slate-800/80 rounded-2xl overflow-hidden transition-all [&[open]]:border-emerald-500/40 [&[open]]:bg-slate-900/70"
            data-category={faq.category}
          >
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
              <div class="pr-4">
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-emerald-400 mb-1">
                  {faq.category}
                </span>
                <h3 class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors">
                  {faq.question}
                </h3>
              </div>
              <span class="shrink-0 w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 group-hover:text-white transition-colors group-open:rotate-180 transition-transform duration-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-sm text-slate-300 leading-relaxed border-t border-slate-800/50 pt-4">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- Support Box -->
      <div class="mt-16 p-8 rounded-3xl bg-slate-900/60 border border-slate-800 text-center">
        <h3 class="text-xl font-bold text-white mb-2">Can't find what you're looking for?</h3>
        <p class="text-sm text-slate-400 max-w-md mx-auto mb-6">
          Reach out directly to the race directors at <a href={`mailto:${general.contactEmail}`} class="text-emerald-400 underline">{general.contactEmail}</a>.
        </p>
      </div>

    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.faq-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.faq-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');

      // Update button styles
      buttons.forEach((b) => {
        b.classList.remove('bg-emerald-400', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
        b.classList.add('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');
      });
      btn.classList.remove('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');
      btn.classList.add('bg-emerald-400', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');

      // Filter items
      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (selected === 'All' || itemCat === selected) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
