---
import Layout from '../layouts/Layout.astro';
import { getRaceData } from '../lib/sanity';

const raceData = await getRaceData();
const { gallery, general } = raceData;
const categories = ['All', '26.TRUE', 'PIONEERS', 'Cheer Squad', 'Finish Line'];
---

<Layout
  title={`Photo Gallery — ${general.name}`}
  description="Explore official photos, cheer squads, and finish line celebrations from 26.TRUE in Boston."
>
  <!-- Header -->
  <section class="bg-black py-16 lg:py-24 border-b border-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#d4ff00] text-black mb-4">
          Visual Memories
        </div>
        <h1 class="font-edo text-5xl sm:text-6xl lg:text-7xl text-white uppercase tracking-normal mb-4">
          26.TRUE Photo Gallery
        </h1>
        <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
          The emotion, the sweat, and the finish line triumph across Jamaica Plain, Roxbury, Mattapan, and Dorchester.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter & Gallery Grid -->
  <section class="py-16 bg-black min-h-[60vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Filter Bar -->
      <div class="flex flex-wrap items-center gap-2 mb-12" id="gallery-filter-bar">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`gallery-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all ${
              idx === 0
                ? 'bg-[#d4ff00] text-black shadow-md shadow-[#d4ff00]/20'
                : 'bg-neutral-950 text-neutral-300 hover:text-white border border-neutral-800'
            }`}
            data-category={cat.toLowerCase().replace('.', '').replace(' ', '-')}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Photo Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery-grid">
        {(gallery || []).map((photo, index) => (
          <button
            type="button"
            class="gallery-item group relative block overflow-hidden rounded-3xl bg-neutral-950 border border-neutral-800 aspect-[4/3] w-full text-left cursor-pointer hover:border-[#d4ff00]/60 transition-all hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-[#d4ff00] shadow-lg"
            data-category={photo.category}
            data-category-label={photo.category.replace('-', ' ')}
            data-src={photo.src}
            data-alt={photo.alt}
            data-photographer={photo.photographer || ''}
            data-index={index}
            aria-label={`View photo ${index + 1}`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <!-- Hover Overlay -->
            <div class="absolute inset-0 p-5 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-black/80 backdrop-blur-md text-[#3fd4a4] border border-neutral-800">
                  {photo.category.replace('-', ' ')}
                </span>
                <span class="w-9 h-9 rounded-full bg-black/80 backdrop-blur-md border border-neutral-700 text-[#d4ff00] flex items-center justify-center shadow-lg">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                </span>
              </div>
              {photo.photographer && (
                <div class="flex items-center">
                  <span class="text-[11px] font-semibold text-neutral-300 px-2.5 py-1 rounded-full bg-black/80 backdrop-blur-md border border-neutral-800">
                    📷 {photo.photographer}
                  </span>
                </div>
              )}
            </div>
          </button>
        ))}
      </div>

      <!-- Lightbox Modal -->
      <div
        id="photo-lightbox"
        class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300 select-none items-center justify-center"
        role="dialog"
        aria-modal="true"
        aria-label="Photo Lightbox"
      >
        <!-- Dark Backdrop -->
        <div id="lightbox-backdrop" class="absolute inset-0 bg-black/95 backdrop-blur-xl"></div>

        <!-- Header Bar: Counter & Close Button -->
        <div class="absolute top-0 inset-x-0 z-30 p-4 sm:p-6 flex items-center justify-between pointer-events-none">
          <div class="pointer-events-auto flex items-center gap-2.5 px-4 py-2 rounded-full bg-neutral-900/90 border border-neutral-800 text-xs font-bold text-neutral-300 shadow-xl">
            <span class="text-[#d4ff00] uppercase tracking-wider font-black">Photo</span>
            <span id="lightbox-counter" class="text-white">1 / 1</span>
            <span id="lightbox-category" class="text-[#3fd4a4] uppercase tracking-wider text-[11px] font-black ml-1 pl-2 border-l border-neutral-800"></span>
          </div>

          <button
            id="lightbox-close"
            type="button"
            class="pointer-events-auto w-11 h-11 rounded-full bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 hover:text-white flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
            aria-label="Close photo view (Esc)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Previous Button -->
        <button
          id="lightbox-prev"
          type="button"
          class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-black/85 hover:bg-neutral-900 border border-neutral-700/80 text-white hover:text-[#d4ff00] flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
          aria-label="Previous photo (Left arrow)"
        >
          <svg class="w-6 h-6 sm:w-7 sm:h-7 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <!-- Next Button -->
        <button
          id="lightbox-next"
          type="button"
          class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-black/85 hover:bg-neutral-900 border border-neutral-700/80 text-white hover:text-[#d4ff00] flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#d4ff00]"
          aria-label="Next photo (Right arrow)"
        >
          <svg class="w-6 h-6 sm:w-7 sm:h-7 -mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- Main Image Presentation Stage -->
        <div class="relative z-20 w-full h-full flex flex-col items-center justify-center p-4 sm:p-12 pointer-events-none">
          <div class="relative pointer-events-auto max-h-[82vh] max-w-[90vw] flex flex-col items-center">
            <img
              id="lightbox-img"
              src=""
              alt=""
              class="max-h-[76vh] sm:max-h-[80vh] max-w-[92vw] sm:max-w-[85vw] object-contain rounded-2xl shadow-2xl border border-neutral-800/80 transition-transform duration-200"
            />
            <div id="lightbox-photographer" class="mt-3 text-center text-xs font-semibold text-neutral-400"></div>
          </div>
        </div>
      </div>

      <!-- Community Upload Box -->
      <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-neutral-950 border border-neutral-800 text-center max-w-3xl mx-auto">
        <span class="text-xs font-black uppercase tracking-widest text-[#d4ff00]">
          Community Photographers & Runners
        </span>
        <h3 class="font-edo text-3xl sm:text-4xl text-white uppercase mt-2 mb-4">
          Share Your 26.TRUE Shots
        </h3>
        <p class="text-sm text-neutral-300 mb-8 max-w-lg mx-auto font-normal">
          Did you snap photos of your crew, the cheer stations, or the finish line? Tag <strong class="text-white">@pioneersrc</strong> or send high-res photos to <a href={`mailto:${general.contactEmail}`} class="text-[#d4ff00] underline">{general.contactEmail}</a> to be featured in the official gallery.
        </p>
        <a
          href={`mailto:${general.contactEmail}?subject=26.TRUE%20Photo%20Submission`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-black uppercase tracking-wider bg-[#d4ff00] hover:bg-[#c3ec00] text-black transition-all"
        >
          <span>Submit Photos</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Filter functionality
  const buttons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-item'));

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');

      // Update button styles
      buttons.forEach((b) => {
        b.classList.remove('bg-[#d4ff00]', 'text-black', 'shadow-md', 'shadow-[#d4ff00]/20');
        b.classList.add('bg-neutral-950', 'text-neutral-300', 'border', 'border-neutral-800');
      });
      btn.classList.remove('bg-neutral-950', 'text-neutral-300', 'border', 'border-neutral-800');
      btn.classList.add('bg-[#d4ff00]', 'text-black', 'shadow-md', 'shadow-[#d4ff00]/20');

      // Filter gallery cards
      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (selected === 'all' || itemCat === selected) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Lightbox modal functionality
  const lightbox = document.getElementById('photo-lightbox');
  const lightboxBackdrop = document.getElementById('lightbox-backdrop');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxCategory = document.getElementById('lightbox-category');
  const lightboxPhotographer = document.getElementById('lightbox-photographer');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let currentVisibleItems: HTMLButtonElement[] = [];
  let currentIndex = 0;

  function getVisibleItems(): HTMLButtonElement[] {
    return items.filter((item) => item.style.display !== 'none');
  }

  function updateLightbox(index: number) {
    if (!currentVisibleItems.length || !lightboxImg) return;

    if (index < 0) {
      currentIndex = currentVisibleItems.length - 1;
    } else if (index >= currentVisibleItems.length) {
      currentIndex = 0;
    } else {
      currentIndex = index;
    }

    const item = currentVisibleItems[currentIndex];
    const src = item.getAttribute('data-src') || '';
    const alt = item.getAttribute('data-alt') || '26.TRUE Photo';
    const photographer = item.getAttribute('data-photographer') || '';
    const categoryLabel = item.getAttribute('data-category-label') || '';

    lightboxImg.src = src;
    lightboxImg.alt = alt;

    if (lightboxCounter) {
      lightboxCounter.textContent = `${currentIndex + 1} / ${currentVisibleItems.length}`;
    }

    if (lightboxCategory) {
      if (categoryLabel) {
        lightboxCategory.textContent = categoryLabel;
        lightboxCategory.style.display = 'inline-block';
      } else {
        lightboxCategory.style.display = 'none';
      }
    }

    if (lightboxPhotographer) {
      if (photographer) {
        lightboxPhotographer.textContent = `📷 ${photographer}`;
        lightboxPhotographer.style.display = 'block';
      } else {
        lightboxPhotographer.textContent = '';
        lightboxPhotographer.style.display = 'none';
      }
    }
  }

  function openLightbox(item: HTMLButtonElement) {
    currentVisibleItems = getVisibleItems();
    const idx = currentVisibleItems.indexOf(item);
    currentIndex = idx >= 0 ? idx : 0;

    if (!lightbox) return;

    updateLightbox(currentIndex);

    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    requestAnimationFrame(() => {
      lightbox.classList.remove('opacity-0');
      lightbox.classList.add('opacity-100');
    });

    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('opacity-0');
    lightbox.classList.remove('opacity-100');
    setTimeout(() => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      if (lightboxImg) lightboxImg.src = '';
      document.body.style.overflow = '';
    }, 200);
  }

  function showNext() {
    updateLightbox(currentIndex + 1);
  }

  function showPrev() {
    updateLightbox(currentIndex - 1);
  }

  // Open lightbox when a photo card is clicked
  items.forEach((item) => {
    item.addEventListener('click', () => openLightbox(item));
  });

  // Next and Previous controls
  lightboxNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    showNext();
  });

  lightboxPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPrev();
  });

  // Close controls
  lightboxClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeLightbox();
  });

  lightboxBackdrop?.addEventListener('click', () => {
    closeLightbox();
  });

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowRight') {
      showNext();
    } else if (e.key === 'ArrowLeft') {
      showPrev();
    }
  });

  // Touch swipe support for mobile
  let touchStartX = 0;
  let touchEndX = 0;

  lightbox?.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true }
  );

  lightbox?.addEventListener(
    'touchend',
    (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          showNext();
        } else {
          showPrev();
        }
      }
    },
    { passive: true }
  );
</script>
