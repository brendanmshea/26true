---
import Layout from '../layouts/Layout.astro';
import RacePhotoStrip from '../components/RacePhotoStrip.astro';
import { getRaceData } from '../lib/sanity';

const raceData = await getRaceData();
const { general } = raceData;

const inclusions = [
  {
    title: "Marathon or Half Marathon Entry",
    description: "Entry to a Marathon or Half Marathon with a one-of-a-kind route through the heart of the City of Boston",
    icon: "route",
    badge: null,
  },
  {
    title: "Certified Training Plans",
    description: "A training plan designed by local certified run coaches (Beginner and Intermediate levels) - COMING SOON!",
    icon: "coach",
    badge: "COMING SOON!",
  },
  {
    title: "Souvenir Race Bib",
    description: "A 26.TRUE Souvenir Bib",
    icon: "bib",
    badge: null,
  },
  {
    title: "Custom Finisher's Medal",
    description: "A 26.TRUE Custom Marathon/Half Marathon Finisher's Medal",
    icon: "medal",
    badge: null,
  },
  {
    title: "Custom Finisher's Jacket",
    description: "A 26.TRUE Custom Marathon/Half Marathon Finisher's Jacket",
    icon: "jacket",
    badge: null,
  },
  {
    title: "Official Swag Bag",
    description: "A Swag Bag with Collectibles from our Sponsors",
    icon: "bag",
    badge: null,
  },
  {
    title: "Post-Race Meal Ticket",
    description: "One Meal Ticket",
    icon: "meal",
    badge: null,
  },
  {
    title: "Post-Race Drink Ticket",
    description: "One Drink Ticket",
    icon: "drink",
    badge: null,
  },
];
---

<Layout
  title={`Race Info — ${general.name}`}
  description="Event date, registration details, 131 Dale Street start & finish line, runner registration inclusions, and the Finish Line Block Party for 26.TRUE."
>
  <!-- Hero / Race Info Header & Key Logistics -->
  <section class="relative py-12 sm:py-16 lg:py-20 bg-black border-b border-neutral-900 overflow-hidden">
    <!-- Ambient Glow Accent -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute top-0 right-1/4 w-[500px] h-[350px] bg-[#d4ff00]/10 blur-[150px] rounded-full"></div>
      <div class="absolute bottom-0 left-10 w-[400px] h-[300px] bg-[#3fd4a4]/10 blur-[140px] rounded-full"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Column: Title & Key Event Logistics -->
        <div class="lg:col-span-7 space-y-6">

          <h1 class="font-edo text-4xl sm:text-6xl lg:text-7xl text-white uppercase tracking-normal leading-[0.95]">
            Race Info
          </h1>

          <!-- Key Event Details Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            
            <!-- Date Card -->
            <div class="p-5 rounded-2xl bg-neutral-950 border border-neutral-800 hover:border-[#d4ff00]/40 transition-colors">
              <div class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-[#d4ff00] mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>Event Date</span>
              </div>
              <div class="font-bold text-white text-sm sm:text-base leading-snug">
                {general.raceDisplayDate}
              </div>
              <div class="text-[11px] text-neutral-400 mt-1 font-medium">
                Reverse Wave Starts
              </div>
            </div>

            <!-- Location Card -->
            <div class="p-5 rounded-2xl bg-neutral-950 border border-neutral-800 hover:border-[#d4ff00]/40 transition-colors">
              <div class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-[#d4ff00] mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span>Start & Finish</span>
              </div>
              <div class="font-bold text-white text-sm sm:text-base leading-snug">
                131 Dale Street
              </div>
              <div class="text-[11px] text-neutral-400 mt-1 font-medium">
                Shelburne Center, Roxbury
              </div>
            </div>

          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={general.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-7 py-3.5 text-xs sm:text-sm font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] rounded-2xl shadow-xl shadow-[#d4ff00]/20 transition-all transform hover:-translate-y-0.5"
            >
              <span>Register on Movemint</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>

            <a
              href="https://maps.google.com/?q=131+Dale+Street,+Roxbury,+MA+02119"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-white bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 rounded-2xl transition-all"
            >
              <svg class="w-4 h-4 text-[#3fd4a4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              <span>Get Directions to 131 Dale St</span>
            </a>
          </div>

        </div>

        <!-- Right Column: Prominently Featured race_logo.png -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md bg-neutral-950 border border-neutral-800 rounded-3xl p-8 sm:p-10 flex flex-col items-center text-center shadow-2xl group hover:border-[#d4ff00]/50 transition-all">
            <div class="absolute inset-0 bg-gradient-to-b from-[#d4ff00]/5 via-transparent to-black/60 rounded-3xl pointer-events-none"></div>
            
            <img
              src="/images/race_logo.png"
              alt="26.TRUE Marathon Official Logo"
              class="w-full max-w-[280px] sm:max-w-[320px] h-auto object-contain mb-6 drop-shadow-[0_12px_30px_rgba(0,0,0,0.9)] group-hover:scale-105 transition-transform duration-300"
            />

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Photo Strip 1: Race Info & Runner Energy (Configurable in Sanity) -->
  <RacePhotoStrip strip={1} />

  <!-- What is Included with Runner Registration -->
  <section class="py-14 sm:py-12 lg:py-14 bg-neutral-950 border-b border-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-12">
        <div class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-2">
          Runner Swag & Experience
        </div>
        <h2 class="font-edo text-3xl sm:text-5xl text-white uppercase tracking-normal">
          Included With Your Registration
        </h2>
        <p class="text-sm sm:text-base text-neutral-300 mt-3 leading-relaxed font-normal">
          Every registered runner is fully supported from training season through the final beat of the Block Party celebration.
        </p>
      </div>

      <!-- Inclusions Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {inclusions.map((item, index) => (
          <div class="relative bg-black border border-neutral-800/90 rounded-2xl p-6 flex flex-col justify-between hover:border-[#d4ff00]/50 transition-all duration-300 hover:-translate-y-1 shadow-xl group">
            
            <div>
              <!-- Top Row: Icon & Optional Badge -->
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-neutral-900 border border-neutral-800 text-[#d4ff00] flex items-center justify-center group-hover:bg-[#d4ff00] group-hover:text-black transition-colors shadow">
                  {item.icon === 'route' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                    </svg>
                  )}
                  {item.icon === 'coach' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                  )}
                  {item.icon === 'bib' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                  )}
                  {item.icon === 'medal' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                    </svg>
                  )}
                  {item.icon === 'jacket' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  )}
                  {item.icon === 'bag' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                  )}
                  {item.icon === 'meal' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                  )}
                  {item.icon === 'drink' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                    </svg>
                  )}
                </div>

                {item.badge && (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#d4ff00] text-black">
                    {item.badge}
                  </span>
                )}
              </div>

              <!-- Title -->
              <h3 class="font-edo text-xl text-white mb-2 tracking-normal group-hover:text-[#3fd4a4] transition-colors">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-normal">
                {item.description}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Photo Strip 2: Block Party Celebration (Configurable in Sanity) -->
  <RacePhotoStrip strip={2} />

  <!-- The Block Party Section -->
  <section class="relative py-12 sm:py-12 bg-neutral-950 border-t border-neutral-900 overflow-hidden" id="block-party">
    
    <!-- Atmospheric Background Glow -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-[#d4ff00]/15 blur-[160px] rounded-full"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-black border border-neutral-800 text-[#3fd4a4] mb-4">
        <span>The Finish Line Celebration</span>
      </div>

      <h2 class="font-edo text-4xl sm:text-6xl lg:text-7xl text-white uppercase tracking-normal mb-8">
        The Block Party
      </h2>

      <!-- Provided Block Party Copy in Highlight Card -->
      <div class="p-8 sm:p-12 rounded-3xl bg-black/90 border border-neutral-800 shadow-2xl max-w-3xl mx-auto mb-10 text-left space-y-5">
        
        <p class="text-base sm:text-xl text-white font-bold leading-relaxed">
          After you put in the hard work, this where the celebratory magic happens!
        </p>

        <p class="text-sm sm:text-base text-neutral-200 leading-relaxed font-normal">
          Food, drinks, DJs, photo ops, recovery stations, immaculate vibes, and everything else you need to feel good and supported after your run.
        </p>

        <p class="text-sm sm:text-base text-[#d4ff00] font-bold leading-relaxed pt-2 border-t border-neutral-800/80">
          Definitely stick around for this and bring your friends, families, neighbors, co-workers, exes, WHOEVER! It's a party!
        </p>

      </div>

      <!-- Feature Pill Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 max-w-2xl mx-auto mb-10">
        <span class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 border border-neutral-800 text-neutral-200">
          🍔 Local Food & Drinks
        </span>
        <span class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 border border-neutral-800 text-neutral-200">
          🎧 Live DJs & Dance Floor
        </span>
        <span class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 border border-neutral-800 text-neutral-200">
          📸 Photo Ops
        </span>
        <span class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 border border-neutral-800 text-neutral-200">
          🧘 Recovery Stations
        </span>
        <span class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 border border-neutral-800 text-[#d4ff00]">
          ✨ Immaculate Vibes
        </span>
        <span class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 border border-neutral-800 text-[#3fd4a4]">
          🤝 Everyone Welcome
        </span>
      </div>

      <!-- Registration CTA inside Block Party section -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={general.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-xs sm:text-sm font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] rounded-2xl shadow-xl shadow-[#d4ff00]/20 transition-all transform hover:-translate-y-0.5"
        >
          <span>Claim Your Spot For 2027</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <a
          href="/course"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-xs sm:text-sm font-bold uppercase tracking-wider text-white bg-black hover:bg-neutral-900 border border-neutral-800 rounded-2xl transition-all"
        >
          <span>Explore The 26.TRUE Course</span>
        </a>
      </div>

    </div>
  </section>

</Layout>
