---
import Layout from '../layouts/Layout.astro';
import { raceData } from '../data/raceData';

const { scheduleDays, general } = raceData;
---

<Layout
  title={`Weekend Schedule — ${general.name}`}
  description="Official weekend timeline, packet pickup logistics, parking, and race morning wave schedule for 26True."
>
  <section class="bg-slate-950 py-16 lg:py-24 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30 mb-4">
          Race Weekend Timeline
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight mb-4">
          Event Schedule
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          From the Health & Fitness Expo to your celebratory post-race pint, here is everything happening over race weekend.
        </p>
      </div>
    </div>
  </section>

  <!-- Packet Pickup Important Notice Card -->
  <section class="bg-amber-950/30 border-b border-amber-500/20 py-8" id="packet-pickup">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-base font-bold text-white">Important: No Race-Morning Packet Pickup</h2>
            <p class="text-xs sm:text-sm text-amber-200/80 mt-0.5">
              All bibs must be collected on Friday (1 PM–7 PM) or Saturday (10 AM–5 PM) at the Expo. If you cannot attend, a friend may pick up your packet with your confirmation barcode and a copy of your photo ID.
            </p>
          </div>
        </div>
        <a
          href="/faq"
          class="shrink-0 px-4 py-2 rounded-xl text-xs font-bold bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 transition-colors"
        >
          Bib Transfer & Proxy Rules
        </a>
      </div>
    </div>
  </section>

  <!-- Day by Day Timeline -->
  <section class="py-16 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-16">
        {scheduleDays.map((day) => (
          <div>
            <div class="flex items-center gap-4 mb-8 pb-4 border-b border-slate-800">
              <span class="px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30">
                {day.dayOfWeek}
              </span>
              <h2 class="text-2xl font-black text-white">
                {day.date}
              </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {day.events.map((evt) => (
                <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 flex flex-col justify-between">
                  <div>
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-500/20 mb-3">
                      {evt.time}
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">
                      {evt.title}
                    </h3>
                    <div class="text-xs font-medium text-slate-400 mb-3 flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                      <span>{evt.location}</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                      {evt.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
