---
import Layout from '../layouts/Layout.astro';
import { getRaceData } from '../lib/sanity';

const raceData = await getRaceData();
const { course, general } = raceData;
---

<Layout
  title={`Neighborhood Course Route — ${general.name}`}
  description="Official Google Map, Strava route, and course locations logo for 26.TRUE through Jamaica Plain, Roxbury, Mattapan, and Dorchester."
>
  <!-- Course Overview Section with race_locations_logo.png prominently featured -->
  <section class="py-16 bg-black border-b border-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <div class="text-xs font-black uppercase tracking-widest text-[#d4ff00]">
            The Journey
          </div>
          <h2 class="font-edo text-3xl sm:text-5xl text-white uppercase leading-tight">
            Streets Full of Culture & Community
          </h2>
          <p class="text-sm sm:text-base text-neutral-300 leading-relaxed font-normal">
            Every mile is an authentic celebration. You'll run past Malcolm X Park, through the vibrant commercial corridor of Nubian Square, down Dorchester Ave, across the scenic Franklin Park Playstead, along Mattapan Square, and through the Southwest Corridor path in Jamaica Plain.
          </p>
          <div class="p-5 rounded-2xl bg-neutral-950 border border-neutral-800">
            <div class="text-xs font-black uppercase tracking-wider text-[#3fd4a4] mb-1">Untimed & Fully Supported</div>
            <div class="text-xs text-neutral-300 leading-relaxed">
              Run at your pace. Slower runners start first in our 5 reverse waves. Our volunteer sweep crews and community cheer squads stay out until the final runner finishes their journey.
            </div>
          </div>
        </div>

        <!-- Featured Race Locations Logo -->
        <div class="lg:col-span-6 flex justify-center">
          <div class="w-full max-w-md bg-neutral-950 border border-neutral-800 rounded-3xl p-8 flex flex-col items-center text-center shadow-2xl group hover:border-[#d4ff00]/40 transition-colors">
            <img
              src="/images/race_locations_logo.png"
              alt="26.TRUE Course Footprint — Jamaica Plain, Roxbury, Mattapan, Dorchester"
              class="w-full max-w-[340px] h-auto object-contain mb-6 drop-shadow-[0_10px_25px_rgba(0,0,0,0.9)] group-hover:scale-105 transition-transform duration-300"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- The 4 Neighborhoods Cards -->
  <section class="bg-neutral-950 border-b border-neutral-900 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {(course?.neighborhoods || []).map((n) => (
          <div class="bg-black border border-neutral-800 p-5 rounded-2xl flex flex-col justify-between hover:border-[#d4ff00]/40 transition-colors">
            <div>
              <div class="font-edo text-2xl text-white mb-1">{n.name}</div>
              <div class="text-xs font-semibold text-[#3fd4a4] mb-2">{n.highlight}</div>
              <div class="text-xs text-neutral-400 leading-relaxed">{n.description}</div>
            </div>
            <div class="mt-4 pt-3 border-t border-neutral-900 text-[10px] font-black uppercase tracking-wider text-[#d4ff00]">
              Official Neighborhood Sector
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Map Section (Embedded Google My Maps & Strava Route) -->
  <section class="py-16 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
        <div>
          <span class="text-xs font-black uppercase tracking-widest text-[#d4ff00] block mb-1">
            Interactive Navigation
          </span>
          <h2 class="font-edo text-3xl sm:text-4xl text-white uppercase">
            Official Course Map
          </h2>
          <p class="text-xs sm:text-sm text-neutral-400 mt-1">
            Explore every street, turn, and Cheer Zone on the Google Map below or follow on Strava.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={course.stravaRouteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-black uppercase tracking-wider text-white bg-black hover:bg-neutral-900 border border-neutral-800 hover:border-[#fc4c02]/50 transition-colors"
          >
            <span class="text-[#fc4c02] font-black">Strava</span>
            <span>View Strava Route</span>
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
          <a
            href={course.googleMapsViewerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-black uppercase tracking-wider text-black bg-[#d4ff00] hover:bg-[#c3ec00] transition-colors"
          >
            <span>Open Google Maps</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Embedded Google Map -->
      <div class="w-full h-[550px] sm:h-[620px] rounded-3xl overflow-hidden border border-neutral-800 relative bg-neutral-950 shadow-2xl mb-16">
        <iframe
          src={course.googleMapsEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="26.TRUE Course Map (Google My Maps)"
        ></iframe>
      </div>

      <!-- Cheer Zones Guide -->
      <div class="pt-8 border-t border-neutral-900">
        <div class="max-w-3xl mb-8">
          <div class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-2">
            If You're Not Running, You're Cheering
          </div>
          <h2 class="font-edo text-3xl sm:text-4xl text-white uppercase mb-3">
            Cheer Zones
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-normal">
            Stationed every 2–3 miles along the course and hosted by community organizations, local running clubs, and partners. Supplying hydration, nutrition, safety, noise makers, bubble machines, and pure joy.
          </p>
        </div>

        <!-- Coming Soon Callout -->
        <div class="p-8 sm:p-12 rounded-3xl bg-neutral-950 border border-neutral-800 text-center max-w-2xl">
          <div class="w-12 h-12 rounded-2xl bg-neutral-900 border border-neutral-800 text-[#d4ff00] flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
            </svg>
          </div>
          <h3 class="font-edo text-2xl sm:text-3xl text-white uppercase tracking-normal mb-2">
            Cheer zone details coming soon!
          </h3>
          <p class="text-sm text-neutral-400 max-w-md mx-auto leading-relaxed font-normal">
            Specific locations, community crew hosts, and mileage markers will be announced as we get closer to race day.
          </p>
          <div class="mt-6">
            <a
              href="mailto:26.true@pioneersrc.com?subject=26.TRUE%20Cheer%20Zone%20Hosting"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-black uppercase tracking-wider bg-[#d4ff00] hover:bg-[#c3ec00] text-black transition-all"
            >
              <span>Host A Cheer Zone</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
