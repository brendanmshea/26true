---
import Layout from '../layouts/Layout.astro';
import { raceData } from '../data/raceData';

const { course, general } = raceData;
---

<Layout
  title={`Neighborhood Course Route — ${general.name}`}
  description="Full course guide, neighborhood milestones, and cheer station guide for the 26.TRUE Marathon and Half Marathon."
>
  <!-- Page Header -->
  <section class="bg-black py-16 lg:py-24 border-b border-neutral-900 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#d4ff00] text-black mb-4">
          100% City of Boston
        </div>
        <h1 class="font-edo text-5xl sm:text-6xl lg:text-7xl text-white uppercase tracking-normal mb-4">
          The Neighborhood Route
        </h1>
        <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
          Running through the cultural and community core of Boston. Covering full 26.2 marathon and 13.1 half marathon routes through Roxbury, Dorchester, Mattapan, Jamaica Plain, Hyde Park, and the South End.
        </p>
      </div>
    </div>
  </section>

  <!-- Neighborhood Highlights Bar -->
  <section class="bg-neutral-950 border-b border-neutral-900 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {course.neighborhoods.map((n) => (
          <div class="bg-black border border-neutral-800 p-4 rounded-2xl flex flex-col justify-between">
            <div>
              <div class="font-edo text-xl text-white mb-1">{n.name}</div>
              <div class="text-[11px] text-neutral-400 leading-tight">{n.highlight}</div>
            </div>
            <div class="mt-3 text-[10px] font-black uppercase tracking-wider text-[#3fd4a4]">
              Neighborhood Stop
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Map Presentation & Artwork -->
  <section class="py-16 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16">
        <div class="lg:col-span-5 space-y-6">
          <div class="text-xs font-black uppercase tracking-widest text-[#d4ff00]">
            The Journey
          </div>
          <h2 class="font-edo text-3xl sm:text-4xl text-white uppercase">
            Streets Full of Culture & Community
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-normal">
            Every mile is an authentic celebration. You'll run past Malcolm X Park, through the vibrant commercial corridor of Nubian Square, down Dorchester Ave, across the scenic Franklin Park Playstead, along Mattapan Square, and through the Southwest Corridor path.
          </p>
          <div class="p-5 rounded-2xl bg-neutral-950 border border-neutral-800">
            <div class="text-xs font-black uppercase tracking-wider text-[#3fd4a4] mb-1">Untimed & Supported</div>
            <div class="text-xs text-neutral-400">
              Run at your pace. Our volunteers, sweep crews, and community cheer squads stay out until the final runner finishes their journey.
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="bg-neutral-950 border border-neutral-800 rounded-3xl p-6 sm:p-8 flex flex-col items-center text-center">
            <img
              src="/images/race_locations_logo.png"
              alt="26.TRUE Route Artwork"
              class="w-full max-w-[400px] h-auto object-contain mb-4"
            />
            <span class="text-xs font-black uppercase tracking-widest text-[#d4ff00]">
              Official 26.TRUE Course Footprint
            </span>
          </div>
        </div>
      </div>

      <!-- Cheer Stations Table -->
      <div class="pt-10 border-t border-neutral-900">
        <div class="max-w-3xl mb-12">
          <div class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-2">
            Hype & Hydration
          </div>
          <h2 class="font-edo text-3xl sm:text-4xl text-white uppercase mb-3">
            Cheer Stations & Community Hubs
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-normal">
            Powered by local run crews, neighborhood associations, DJs, and families holding down their blocks with music, water, fruit, and loud love.
          </p>
        </div>

        <div class="bg-neutral-950 border border-neutral-800 rounded-3xl overflow-hidden shadow-2xl">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-neutral-300">
              <thead class="bg-neutral-900/90 text-xs font-black uppercase tracking-wider text-neutral-400 border-b border-neutral-800">
                <tr>
                  <th scope="col" class="py-4 px-6">Mile</th>
                  <th scope="col" class="py-4 px-6">Neighborhood Hub</th>
                  <th scope="col" class="py-4 px-6">Vibe & Amenities</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-900">
                {course.cheerStations.map((station) => (
                  <tr class="hover:bg-neutral-900/40 transition-colors">
                    <td class="py-4 px-6 font-edo text-xl text-[#d4ff00] whitespace-nowrap">
                      Mile {station.mile.toFixed(1)}
                    </td>
                    <td class="py-4 px-6">
                      <div class="font-bold text-white text-base">{station.neighborhood}</div>
                      <div class="text-xs text-neutral-400">{station.location}</div>
                    </td>
                    <td class="py-4 px-6">
                      <div class="text-xs font-bold text-[#3fd4a4] mb-1.5">{station.vibe}</div>
                      <div class="flex flex-wrap gap-1.5">
                        {station.amenities.map((item) => (
                          <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-neutral-900 text-neutral-300 border border-neutral-800">
                            {item}
                          </span>
                        ))}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
