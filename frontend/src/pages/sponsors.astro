---
import Layout from '../layouts/Layout.astro';
import SponsorGrid from '../components/SponsorGrid.astro';
import { raceData } from '../data/raceData';

const { general } = raceData;
---

<Layout
  title={`Sponsors & Partners — ${general.name}`}
  description="Meet the generous corporate partners and local businesses supporting the 26True Marathon."
>
  <section class="bg-slate-950 py-16 lg:py-24 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30 mb-4">
          Community & Corporate Support
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight mb-4">
          Our Partners & Sponsors
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          The 26True Marathon is made possible through the generous commitment of brands who champion human endurance, wellness, and youth athletic empowerment.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Grid -->
  <SponsorGrid />

  <!-- Sponsorship Opportunities Section -->
  <section class="py-20 bg-slate-950 border-t border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 rounded-3xl p-8 sm:p-12 text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">
          Partner With 26True
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight mt-2 mb-4">
          Connect With 3,500 Dedicated Athletes
        </h2>
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
          From on-course mile marker activations to digital email campaigns and expo booth space, we create customized partnership packages tailored to your brand's community goals.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left max-w-3xl mx-auto mb-10">
          <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
            <div class="text-2xl font-black text-emerald-400 mb-1">3,500+</div>
            <div class="text-xs font-bold text-white">Registered Athletes</div>
            <div class="text-[11px] text-slate-400 mt-1">High-intent runners & endurance enthusiasts</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
            <div class="text-2xl font-black text-emerald-400 mb-1">12,000+</div>
            <div class="text-xs font-bold text-white">Course Spectators</div>
            <div class="text-[11px] text-slate-400 mt-1">Lining the bridges, parks, and finish festival</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
            <div class="text-2xl font-black text-emerald-400 mb-1">501(c)(3)</div>
            <div class="text-xs font-bold text-white">Charity Beneficiary</div>
            <div class="text-[11px] text-slate-400 mt-1">Direct community impact & tax deductible tiers</div>
          </div>
        </div>

        <a
          href={`mailto:${general.sponsorEmail}?subject=26True%202026%20Sponsorship%20Inquiry`}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl text-base font-bold bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 text-slate-950 shadow-xl shadow-emerald-500/20 transition-all"
        >
          <span>Request 2026 Sponsorship Package</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
