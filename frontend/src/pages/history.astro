---
import Layout from '../layouts/Layout.astro';
import { getRaceData } from '../lib/sanity';

const raceData = await getRaceData();
const { general, growthYears } = raceData;
---

<Layout
  title={`History & 6 Years of Growth — ${general.name}`}
  description="The origin story of 26.TRUE and PIONEERS Run Crew: bringing marathon culture to Jamaica Plain, Roxbury, Mattapan, and Dorchester."
>

  <!-- Mayor Michelle Wu Proclamation Section -->
  <section class="py-16 bg-neutral-950 border-b border-neutral-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block w-12 h-1 bg-[#d4ff00] mb-6"></div>
      <blockquote class="font-edo text-2xl sm:text-3xl lg:text-4xl text-white tracking-normal leading-snug mb-6">
        &ldquo;26.TRUE is the real Boston Marathon because it runs through the heart of our neighborhoods and reflects the true soul of our city.&rdquo;
      </blockquote>
      <div class="text-xs font-black uppercase tracking-widest text-[#3fd4a4]">
        — Mayor Michelle Wu, City of Boston
      </div>
    </div>
  </section>

  <!-- Deep Dive Story & Photo Grid -->
  <section class="py-20 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20">
        <div class="lg:col-span-6 space-y-6 text-neutral-300 text-sm sm:text-base leading-relaxed">
          <div class="text-xs font-black uppercase tracking-widest text-[#d4ff00]">
            The Spark
          </div>
          <h2 class="font-edo text-3xl sm:text-4xl text-white uppercase">
            A Course Built For Our Community
          </h2>
          <p>
            Established in 2021 by the leaders of <strong class="text-white">PIONEERS Run Crew</strong>, 26.TRUE was founded as a celebration of running and of Boston’s diverse neighborhoods and people. This is not a competitive race that centers elitism and the fastest, fittest runners. It is built to welcome runners of every pace and background to tour Boston — Our City. Our Way.
          </p>
                    <p>
            In 2025, we debuted our 13.1 mile loop through Jamaica Plain, Roxbury, Dorchester, and Mattapan to accomodate our growing field of runners safely while continuing to focus on the heart of Boston.
          </p>
          <p>
            In 2026, PIONEERS introduced the half marathon distance event alongside the full. The community asked, and we responded: <strong class="text-[#d4ff00]">it sold out in 36 hours</strong>, giving dozens of runners their first opportunity to complete a half marathon.
          </p>
        </div>

        <div class="lg:col-span-6">
          <div class="relative rounded-3xl overflow-hidden bg-neutral-950 border border-neutral-800 p-4">
            <img
              src="/images/photos/web/562A6072.jpg"
              alt="PIONEERS Run Crew Community Gathering"
              class="w-full h-auto object-cover rounded-2xl"
            />
            <div class="p-4 text-center">
              <span class="text-xs font-black uppercase tracking-wider text-[#3fd4a4]">
                PIONEERS Run Crew &bull; Founded 2017
              </span>
              <p class="text-xs text-neutral-400 mt-1">
                900+ active members &bull; 12,000+ followers &bull; Based in Dorchester, MA
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- 6 Years of Growth Timeline (From Canva Slide 4 & 6) -->
      <div class="max-w-4xl mx-auto pt-10 border-t border-neutral-900">
        <div class="text-center mb-16">
          <h2 class="text-xs font-black uppercase tracking-widest text-[#d4ff00] mb-2">
            7 Years of Momentum
          </h2>
          <p class="font-edo text-3xl sm:text-4xl text-white uppercase">
            From 30 Runners To A Boston Institution
          </p>
          <p class="text-xs sm:text-sm text-neutral-400 mt-2">
            Prioritizing quality over quantity with intentional, sustainable community growth.
          </p>
        </div>

        <div class="space-y-10">
          {(growthYears || []).map((gy) => (
            <div class="relative pl-8 sm:pl-12 border-l-2 border-[#d4ff00]/40 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-black border-2 border-[#d4ff00] group-hover:bg-[#d4ff00] transition-colors"></div>
              
              <div class="flex flex-wrap items-baseline gap-3 mb-1">
                <span class="font-edo text-2xl sm:text-3xl text-[#d4ff00]">{gy.year}</span>
                <span class="text-xs font-bold text-neutral-400 font-mono">{gy.date}</span>
              </div>

              <div class="text-sm font-black text-white uppercase tracking-wider mb-2">
                {gy.stats}
              </div>

              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
                {gy.highlight}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- About PIONEERS Callout -->
      <div class="mt-24 p-8 sm:p-12 rounded-3xl bg-neutral-950 border border-neutral-800 max-w-4xl mx-auto flex flex-col sm:flex-row items-center gap-8">
        <div class="shrink-0">
          <img
            src="/images/Pioneers Logo - white.svg"
            alt="PIONEERS Run Crew Logo"
            class="w-28 h-28 object-contain"
          />
        </div>
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-[#d4ff00]">The Organizing Community</span>
          <h3 class="font-edo text-2xl sm:text-3xl text-white uppercase mt-1 mb-3">
            PIONEERS Run Crew
          </h3>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed mb-4 font-normal">
            Founded IN 2017, PIONEERS Run Crew is built on three core pillars: Explore, Motivate, and Inspire. We make running equitable, accessible, and fun for all.
          </p>
          <a
            href="https://www.pioneersrc.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-black uppercase tracking-wider text-[#3fd4a4] hover:text-[#d4ff00] transition-colors inline-flex items-center gap-1.5"
          >
            <span>Visit pioneersrc.com</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
